<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3: Testprojekte sind eigenstaendige Executables, der Runner laeuft im selben Prozess. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Faolan.Soak.Tests</RootNamespace>
    <Description>WP5.4: Soak- und Chaos-Harness. Faehrt Dauerlast mit Stoerungen gegen einen echten
      Gateway-Prozess, schreibt die Messreihe fortlaufend mit und urteilt ueber Wachstum,
      Kindprozesse und Erholung.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Faolan.Server\Faolan.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Faolan.Persistence.Migrations.Sqlite\Faolan.Persistence.Migrations.Sqlite.csproj" />
    <!-- Nur Build-Reihenfolge: die TestServer werden als externe Prozesse gestartet. -->
    <ProjectReference Include="..\..\Faolan.TestServers\EchoServer\Faolan.TestServers.EchoServer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Faolan.TestServers\CrashServer\Faolan.TestServers.CrashServer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Faolan.TestServers\SlowServer\Faolan.TestServers.SlowServer.csproj" ReferenceOutputAssembly="false" />

    <!-- Der Prozess-Harness aus WP5.3, verlinkt statt nachgebaut: Wie ein Gateway gestartet,
         freigeschaltet und wieder abgeraeumt wird, gibt es genau einmal. Zwei Fassungen wuerden
         irgendwann unterschiedlich aufraeumen — und ausgerechnet das prueft dieses Projekt. -->
    <Compile Include="..\..\Faolan.Performance.Tests\Harness\GatewayProcess.cs" Link="Harness\GatewayProcess.cs" />
    <!-- Dieselbe Prozesssuche wie im OrphanHost und in den Integrationstests (siehe dort). -->
    <Compile Include="..\..\Faolan.TestServers\Common\UpstreamProcessLookup.cs" Link="Harness\UpstreamProcessLookup.cs" />

    <!-- FR-P056: Haengt ein Lauf, entsteht ein Bericht mit Sequenz und aktiven
         Kindprozessen. Verlinkt statt nachgebaut — vier Projekte starten echte Prozesse,
         und vier Fassungen davon waeren vier Wahrheiten. -->
    <Compile Include="..\..\Faolan.TestServers\Common\HangReport.cs" Link="Harness\HangReport.cs" />
    <Compile Include="..\..\Faolan.TestServers\Common\HangWatchdog.cs" Link="Harness\HangWatchdog.cs" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

</Project>
