<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3: Testprojekte sind eigenstaendige Executables, der Runner laeuft im selben Prozess. -->
    <OutputType>Exe</OutputType>
    <Description>WP2.6: Upgrade-Kompatibilitaetsmatrix. Faehrt Datenbestaende aus aelteren
      Migrationsstaenden gegen den heutigen Stand hoch und prueft, dass dabei nichts verloren geht.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bifrost.Persistence\Bifrost.Persistence.csproj" />
    <!-- Die Fixtures entstehen aus den ECHTEN Migrationen, nicht aus nachgebautem SQL.
         Deshalb muessen beide Migrations-Assemblies zur Laufzeit vorliegen. -->
    <ProjectReference Include="..\..\src\Bifrost.Persistence.Migrations.Sqlite\Bifrost.Persistence.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Bifrost.Persistence.Migrations.Postgres\Bifrost.Persistence.Migrations.Postgres.csproj" />
    <!-- Welchen PostgreSQL-Server eine Suite starten darf, haengt am vorhandenen pg_dump — und
         diese Ableitung gibt es genau einmal, verlinkt statt kopiert. Zwei Fassungen waeren zwei
         Wahrheiten darueber, was hier startbar ist; die eine bekaeme irgendwann eine Korrektur, die
         die andere nicht kennt. Dieselbe Begruendung wie bei UpstreamProcessLookup und
         SecretCorpus in Bifrost.Integration.Tests. -->
    <Compile Include="..\Bifrost.Integration.Tests\Operations\PostgresServerImage.cs"
             Link="Harness\PostgresServerImage.cs" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

</Project>
