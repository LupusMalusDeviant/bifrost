<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3: Testprojekte sind eigenstaendige Executables, der Runner laeuft im selben Prozess. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bifrost.Server\Bifrost.Server.csproj" />
    <ProjectReference Include="..\..\src\Bifrost.Persistence.Migrations.Sqlite\Bifrost.Persistence.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Bifrost.Persistence.Migrations.Postgres\Bifrost.Persistence.Migrations.Postgres.csproj" />
    <!-- Nur Build-Reihenfolge: TestServer werden als externe Prozesse gestartet, nicht referenziert. -->
    <ProjectReference Include="..\Bifrost.TestServers\EchoServer\Bifrost.TestServers.EchoServer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Bifrost.TestServers\CrashServer\Bifrost.TestServers.CrashServer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Bifrost.TestServers\SlowServer\Bifrost.TestServers.SlowServer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Bifrost.TestServers\HttpServer\Bifrost.TestServers.HttpServer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Bifrost.TestServers\BulkServer\Bifrost.TestServers.BulkServer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Bifrost.TestServers\WasiHostStub\Bifrost.TestServers.WasiHostStub.csproj" ReferenceOutputAssembly="false" />
    <!-- Dieselbe Prozesssuche wie im OrphanHost. Getrennte Fassungen waeren zwei Wahrheiten
         darueber, was "der Upstream laeuft" heisst — und der Unterschied faellt erst auf einer
         anderen Plattform auf. -->
    <Compile Include="..\Bifrost.TestServers\Common\UpstreamProcessLookup.cs"
             Link="Common\UpstreamProcessLookup.cs" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

</Project>
