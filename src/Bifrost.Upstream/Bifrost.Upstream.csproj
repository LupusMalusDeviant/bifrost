<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>IUpstreamConnector-Implementierungen: Stdio, StreamableHttp, OpenApi. Einziges src-Projekt neben Server mit ModelContextProtocol-Abhängigkeit (Client-Seite).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Die Container-Policy (ADR-0018) ist Implementierungsdetail, muss aber pruefbar sein:
         Was der Aufruf an Haertung mitgibt, gehoert in einen Test und nicht in eine Sichtpruefung. -->
    <InternalsVisibleTo Include="Bifrost.Upstream.Tests" />
    <InternalsVisibleTo Include="Bifrost.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bifrost.Abstractions\Bifrost.Abstractions.csproj" />
    <!-- Nur die Client-Seite: .Core statt des Hauptpakets. Das Hauptpaket bringt zusaetzlich
         Hosting/DI und Attribut-Discovery fuer SERVER mit — beides braucht hier niemand, und was
         nicht referenziert ist, kann auch nicht versehentlich benutzt werden. -->
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

</Project>
