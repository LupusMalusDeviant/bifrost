@page "/approvals"
@attribute [Authorize(Policy = UiPolicies.Operator)]
@inject IApprovalStore ApprovalQueue
@inject IApprovalPolicy Policy
@inject IToolCatalog Catalog
@inject IAuditSink Audit
@inject TimeProvider Time
@inject AuthenticationStateProvider AuthState

<h1>Freigaben</h1>
<p class="muted">
    Tools, die eine menschliche Freigabe pro Aufruf erfordern (FR-32). Ein wartender Aufruf wird
    sofort abgewiesen; der Agent setzt ihn nach der Freigabe erneut ab.
</p>

<div class="card">
    <h3 style="margin-top:0">Wartende Anfragen</h3>
    @if (_pending.Count == 0)
    {
        <p class="muted">Nichts offen.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Angefordert (UTC)</th><th>Aufrufer</th><th>Tool</th><th>Argumente (maskiert)</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _pending)
                    {
                        <tr>
                            <td class="mono">@r.RequestedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                            <td>@r.CallerDescription</td>
                            <td class="mono">@r.Tool.Value</td>
                            <td><pre class="mono" style="max-width:340px;white-space:pre-wrap">@(r.RedactedArguments?.GetRawText() ?? "—")</pre></td>
                            <td style="white-space:nowrap">
                                <button class="btn-sm" @onclick="() => Decide(r.Id, true)">Freigeben</button>
                                <button class="btn-sm btn-danger" @onclick="() => Decide(r.Id, false)">Ablehnen</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted" style="margin-bottom:0">
            Eine Freigabe gilt <strong>einmalig</strong> für genau diesen Aufruf (Identität, Tool,
            Argumente) und verfällt nach einer Stunde. Eine Wiederholung erfordert erneute Freigabe.
        </p>
    }
    @if (_message is not null)
    {
        <p class="msg-ok">@_message</p>
    }
</div>

<AuthorizeView Policy="@UiPolicies.Admin">
    <div class="card">
        <h3 style="margin-top:0">Scharfe Tools</h3>
        <p class="muted">
            Welche Tools als gefährlich gelten — und wie das durchgesetzt wird. Zur Laufzeit, ohne
            Neustart.
        </p>
        <ul class="muted" style="margin:0 0 1rem 1.1rem;padding:0">
            <li>
                <b>Warteschlange</b> — der Aufruf wartet hier auf deine Entscheidung. Das Gateway
                hält ihn auf, unabhängig davon, welcher Client fragt.
            </li>
            <li>
                <b>Client fragt</b> — das Gateway führt sofort aus, verlangt aber den Aufruf über
                <code>invoke_sensitive_tool</code>. Damit kann ein Client seine eigene Rückfrage
                genau auf diese Werkzeuge legen. <b>Das Gateway hält dann nichts mehr auf:</b> Ein
                Client, der nicht fragt, kommt ungebremst durch. Protokolliert wird weiterhin alles.
            </li>
        </ul>
        <p>
            <b>Vorgabe für alles Scharfe ohne eigene Festlegung:</b>
            <select style="width:auto" @onchange="e => SetDefault((string?)e.Value)">
                <option value="@nameof(ApprovalEnforcement.Queue)"
                        selected="@(_default == ApprovalEnforcement.Queue)">Warteschlange</option>
                <option value="@nameof(ApprovalEnforcement.Client)"
                        selected="@(_default == ApprovalEnforcement.Client)">Client fragt</option>
            </select>
            <span class="muted">
                Gilt für Werkzeuge, die sich über ihr Connector-Paket selbst als scharf melden —
                die haben keine eigene Zeile, an der sich etwas hinterlegen ließe. Ändert
                <b>nichts</b> an den unten ausdrücklich gesetzten Werkzeugen, und nichts an den
                Rückfällen bei Unklarheit: Ein unbekannter Wert in der Datenbank landet immer auf
                Warteschlange, egal was hier steht.
            </span>
        </p>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Tool</th><th>Durchsetzung</th></tr></thead>
                <tbody>
                    @foreach (var tool in _allTools)
                    {
                        <tr>
                            <td class="mono">@tool.Value</td>
                            <td>
                                <select style="width:auto"
                                        @onchange="e => SetEnforcement(tool, (string?)e.Value)">
                                    <option value="" selected="@(!_marked.ContainsKey(tool))">nicht scharf</option>
                                    <option value="@nameof(ApprovalEnforcement.Queue)"
                                            selected="@(_marked.TryGetValue(tool, out var q) && q == ApprovalEnforcement.Queue)">
                                        Warteschlange
                                    </option>
                                    <option value="@nameof(ApprovalEnforcement.Client)"
                                            selected="@(_marked.TryGetValue(tool, out var c) && c == ApprovalEnforcement.Client)">
                                        Client fragt
                                    </option>
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</AuthorizeView>

@code {
    private IReadOnlyList<ApprovalRequest> _pending = [];
    private IReadOnlyList<NamespacedToolName> _allTools = [];
    private Dictionary<NamespacedToolName, ApprovalEnforcement> _marked = [];
    private ApprovalEnforcement _default = ApprovalEnforcement.Queue;
    private string? _message;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _pending = await ApprovalQueue.ListAsync(ApprovalState.Pending, CancellationToken.None);
        _allTools = Catalog.Snapshot.Where(e => e.Kind == CatalogEntryKind.Tool)
            .Select(e => e.Name).OrderBy(n => n.Value, StringComparer.Ordinal).ToList();
        _marked = Policy.All
            .Select(t => (Tool: t, Mode: Policy.EnforcementFor(t)))
            .Where(x => x.Mode is not null)
            .ToDictionary(x => x.Tool, x => x.Mode!.Value);
        _default = Policy.DefaultEnforcement;
    }

    private async Task SetDefault(string? mode)
    {
        if (!Enum.TryParse<ApprovalEnforcement>(mode, ignoreCase: true, out var parsed))
        {
            return;
        }

        await Policy.SetDefaultEnforcementAsync(parsed, CancellationToken.None);
        UiAudit.Record(Audit, Time, await UserAsync(), AuditEventKind.ConfigChanged,
            $"approval-default-mode:{parsed}");
        _message = parsed is ApprovalEnforcement.Client
            ? "Vorgabe steht auf 'Client fragt'. Neue scharfe Werkzeuge werden vom Gateway nicht "
              + "mehr aufgehalten — der Schutz haengt dann an der Konfiguration des jeweiligen Clients."
            : null;
        await Reload();
    }

    private async Task<string> UserAsync()
        => (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "?";

    private async Task Decide(Guid id, bool approved)
    {
        await ApprovalQueue.DecideAsync(id, approved, CancellationToken.None);
        UiAudit.Record(Audit, Time, await UserAsync(), AuditEventKind.ConfigChanged,
            $"approval-{(approved ? "granted" : "denied")}:{id}");
        _message = approved
            ? "Freigegeben. Der Agent kann den Aufruf jetzt erneut absetzen."
            : "Abgelehnt.";
        await Reload();
    }

    private async Task SetEnforcement(NamespacedToolName tool, string? mode)
    {
        // Leer heisst "nicht scharf". Ein unbekannter Wert kaeme nur aus einer manipulierten
        // Auswahlliste — dann lieber nichts tun als raten.
        ApprovalEnforcement? enforcement = null;
        if (!string.IsNullOrEmpty(mode))
        {
            if (!Enum.TryParse<ApprovalEnforcement>(mode, ignoreCase: true, out var parsed))
            {
                return;
            }

            enforcement = parsed;
        }

        await Policy.SetAsync(tool, enforcement, CancellationToken.None);
        UiAudit.Record(Audit, Time, await UserAsync(), AuditEventKind.ConfigChanged,
            enforcement is { } set
                ? $"approval-tool-required-{set}:{tool.Value}"
                : $"approval-tool-cleared:{tool.Value}");
        _message = enforcement is ApprovalEnforcement.Client
            ? $"'{tool.Value}': Das Gateway haelt diesen Aufruf nicht mehr auf — es verlangt nur noch "
              + "den Weg über invoke_sensitive_tool. Der Schutz liegt jetzt beim Client."
            : null;
        await Reload();
    }
}
