@page "/logs"
@attribute [Authorize(Policy = UiPolicies.Authenticated)]
@using Bifrost.Core.Audit
@inject IAuditQuery AuditQuery
@inject IAuditExport AuditExport
@inject IRbacManagement RbacMgmt
@inject IUpstreamSupervisor Supervisor
@inject IJSRuntime JS

<h1>Audit-Log</h1>
<p class="muted">Wer hat wann was aufgerufen — inkl. verweigerter Calls (FR-21/23).</p>

<div class="card">
    <div class="row">
        <div><label>Tool beginnt mit</label><input @bind="_tool" placeholder="z.B. github__" /></div>
        <div>
            <label>Agent</label>
            <select @bind="_caller">
                <option value="">(alle)</option>
                @foreach (var i in _identities)
                {
                    <option value="@i.Id">@i.Name</option>
                }
            </select>
        </div>
        <div>
            <label>Server</label>
            <select @bind="_server">
                <option value="">(alle)</option>
                @foreach (var s in _servers)
                {
                    <option value="@s.Id">@s.Slug</option>
                }
            </select>
        </div>
        <div>
            <label>Status</label>
            <select @bind="_status">
                <option value="">(alle)</option>
                @foreach (var s in Enum.GetValues<InvocationStatus>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div>
            <label>Herkunft</label>
            <select @bind="_origin">
                <option value="">(alle)</option>
                @foreach (var o in Enum.GetValues<CallOrigin>())
                {
                    <option value="@o">@o</option>
                }
            </select>
        </div>
        <div><label>Seit (Stunden)</label><input type="number" @bind="_hours" min="1" /></div>
    </div>
    <div class="toolbar" style="margin-top:1rem">
        <button @onclick="() => Search(1)">Suchen</button>
        <button class="btn-ghost" @onclick="ExportJson">Export JSON</button>
        <button class="btn-ghost" @onclick="ExportCsv">Export CSV</button>
        <span class="muted">@_result.TotalCount Treffer</span>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead><tr><th>Zeit (UTC)</th><th>Herkunft</th><th>Aufrufer</th><th>Tool / Ereignis</th><th>Status</th><th>Dauer</th></tr></thead>
            <tbody>
                @foreach (var e in _result.Items)
                {
                    <tr>
                        <td class="mono">@e.Timestamp.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</td>
                        <td>@e.Origin</td>
                        <td title="@e.Caller?.ToString()">@(e.CallerRoles ?? e.Caller?.ToString() ?? "System")</td>
                        <td class="mono">@(e.Tool ?? e.Detail ?? "—")</td>
                        <td>@StatusBadge(e.Status)</td>
                        <td class="muted">@(e.Duration is { } d ? $"{d.TotalMilliseconds:0} ms" : "—")</td>
                    </tr>
                    @if (e.RedactedResponse is { } payload)
                    {
                        @* Nur im Audit-Debug-Modus vorhanden; maskiert wie die Argumente. *@
                        <tr>
                            <td colspan="6"><pre class="mono">@payload.GetRawText()</pre></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (_result.TotalCount > _result.PageSize)
    {
        <div class="toolbar" style="margin-top:1rem">
            <button class="btn-sm btn-ghost" disabled="@(_page <= 1)" @onclick="() => Search(_page - 1)">‹ Zurück</button>
            <span class="muted">Seite @_page / @TotalPages</span>
            <button class="btn-sm btn-ghost" disabled="@(_page >= TotalPages)" @onclick="() => Search(_page + 1)">Weiter ›</button>
        </div>
    }
</div>

@* ── Export und Kette (WP6.2) ────────────────────────────────────────────────────────────────
   Beides ist Verwaltung und steht deshalb hinter der Admin-Rolle, waehrend die Ansicht selbst
   jedem Angemeldeten offensteht: Wer sein eigenes Handeln nachlesen darf, darf deshalb noch
   lange nicht das ganze Log ausleiten. *@
<AuthorizeView Policy="@UiPolicies.Admin">
    <div class="card">
        <h3 style="margin-top:0">Export</h3>
        <p class="muted" style="margin-top:0">
            Schreibt <strong>den aktuellen Filter</strong> als Datei — auf dem Rechner, auf dem der
            Gateway läuft, nicht auf diesem hier. Die Zeilen gehen einzeln hinaus; auch ein Log mit
            Millionen Einträgen zieht dabei keinen Arbeitsspeicher mit.
        </p>
        <div class="row">
            <div style="flex:2">
                <label>Zieldatei auf dem Gateway</label>
                @* oninput statt des Vorgabe-Ereignisses: Sonst gilt der Pfad erst, wenn das Feld
                   den Fokus verliert — der Knopf daneben bliebe gesperrt, obwohl etwas dasteht. *@
                <input data-testid="audit-export-path" @bind="_exportPath" @bind:event="oninput"
                       placeholder="/data/exports/audit.jsonl" />
            </div>
            <div>
                <label>Format</label>
                <select data-testid="audit-export-format" @bind="_exportFormat">
                    <option value="Jsonl">JSONL</option>
                    <option value="Csv">CSV</option>
                </select>
            </div>
        </div>
        <p class="muted" style="margin-top:.5rem">
            CSV trägt die maskierten Argumente <strong>nicht</strong> — sie sind JSON und gehören
            nicht in eine Tabellenzelle. Wer sie braucht, nimmt JSONL.
        </p>
        <div class="toolbar" style="margin-top:1rem">
            <button data-testid="audit-export-run" @onclick="Export"
                    disabled="@(_busy || string.IsNullOrWhiteSpace(_exportPath))">
                @(_busy ? "Schreibt …" : "Exportieren")
            </button>
            <button class="btn-ghost" data-testid="audit-verify-run" @onclick="Verify" disabled="@_busy">
                Kette prüfen
            </button>
            @if (_message is not null)
            {
                <span data-testid="audit-message" class="@(_failed ? "msg-err" : "msg-ok")">@_message</span>
            }
        </div>
    </div>

    @if (_chain is not null)
    {
        <div class="card">
            <h3 style="margin-top:0">Integritätskette</h3>
            <p data-testid="audit-chain-result" class="@(_chain.IsIntact ? "msg-ok" : "msg-err")">
                @if (_chain.FirstBreak is { } broken)
                {
                    <text>Bruch ab Zeile @broken.Sequence: @broken.Reason</text>
                }
                else
                {
                    <text>Kein Bruch gefunden — @_chain.Checked verkettete Einträge in
                    @_chain.Segments.Count Abschnitt(en).</text>
                }
            </p>

            @if (_chain.Unchained > 0)
            {
                <p class="muted">
                    @_chain.Unchained Eintrag/Einträge ohne Kettenglied — aus der Zeit vor der Kette.
                    Sie sind kein Befund, aber auch nicht gedeckt.
                </p>
            }

            @* Die Grenzen stehen NEBEN dem Ergebnis, nicht in einer Fußnote: Ein „kein Bruch
               gefunden", das jemand für „nichts fehlt" hält, ist gefährlicher als keine Kette. *@
            <h4>Was diese Prüfung nicht zeigt</h4>
            <ul class="muted" data-testid="audit-chain-limits">
                @foreach (var limit in _chain.Limits)
                {
                    <li>@limit</li>
                }
            </ul>
        </div>
    }
</AuthorizeView>

@code {
    private string _tool = "", _status = "", _origin = "", _caller = "", _server = "";
    private string _exportPath = "", _exportFormat = "Jsonl";
    private bool _busy, _failed;
    private string? _message;
    private AuditChainReport? _chain;
    private int _hours = 24, _page = 1;
    private PagedResult<AuditEvent> _result = new([], 0, 1, 50);
    private IReadOnlyList<Identity> _identities = [];
    private IReadOnlyList<UpstreamStatus> _servers = [];

    private int TotalPages => (int)Math.Ceiling(_result.TotalCount / (double)_result.PageSize);

    protected override async Task OnInitializedAsync()
    {
        // Auswahllisten statt Freitext: Agent- und Server-Filter arbeiten auf Guids, die niemand abtippt.
        _identities = await RbacMgmt.ListIdentitiesAsync(CancellationToken.None);
        _servers = Supervisor.Statuses;
        await Search(1);
    }

    private async Task Search(int page)
    {
        _page = Math.Max(1, page);
        _result = await AuditQuery.QueryAsync(BuildFilter(_page, 50), CancellationToken.None);
    }

    private AuditFilter BuildFilter(int page, int pageSize) => new(
        From: DateTimeOffset.UtcNow.AddHours(-Math.Max(1, _hours)),
        Caller: Guid.TryParse(_caller, out var c) ? new IdentityId(c) : null,
        Server: Guid.TryParse(_server, out var srv) ? new ServerId(srv) : null,
        ToolPrefix: string.IsNullOrWhiteSpace(_tool) ? null : _tool.Trim(),
        Status: Enum.TryParse<InvocationStatus>(_status, out var s) ? s : null,
        Origin: Enum.TryParse<CallOrigin>(_origin, out var o) ? o : null,
        Page: page,
        PageSize: pageSize);

    /// <summary>
    /// Schreibt den Export — Zeile für Zeile in die Datei. Der Umweg über eine Zeichenkette oder
    /// eine Liste wäre genau die Materialisierung, die dieser Weg vermeiden soll.
    /// </summary>
    private async Task Export()
    {
        _busy = true;
        _message = null;
        _failed = false;
        try
        {
            var format = Enum.Parse<AuditExportFormat>(_exportFormat);
            var written = 0L;

            await using (var file = File.Create(Path.GetFullPath(_exportPath)))
            await using (var writer = new StreamWriter(file))
            {
                if (AuditExportWriter.Header(format) is { } header)
                {
                    await writer.WriteLineAsync(header);
                }

                await foreach (var entry in AuditExport.StreamAsync(
                    new AuditExportRequest(BuildFilter(1, 1)), CancellationToken.None))
                {
                    await writer.WriteLineAsync(AuditExportWriter.Line(entry, format));
                    written++;
                }
            }

            _message = $"{written:N0} Zeile(n) nach '{Path.GetFullPath(_exportPath)}' geschrieben.";
        }
        catch (Exception exception)
        {
            _failed = true;
            _message = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Prüft die Kette — <b>ohne den Filter der Ansicht</b>. Über einen gefilterten Ausschnitt lässt
    /// sich über die Kette nichts sagen: Jede herausgefilterte Zeile sähe aus wie eine gelöschte.
    /// </summary>
    private async Task Verify()
    {
        _busy = true;
        _message = null;
        _failed = false;
        try
        {
            _chain = await AuditChainVerifier.VerifyAsync(
                AuditExport.StreamAsync(new AuditExportRequest(new AuditFilter()), CancellationToken.None),
                CancellationToken.None);
        }
        catch (Exception exception)
        {
            _failed = true;
            _message = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static RenderFragment StatusBadge(InvocationStatus? status) => builder =>
    {
        if (status is null) { builder.AddContent(0, "—"); return; }
        var css = status == InvocationStatus.Success ? "badge-ok"
            : status == InvocationStatus.Denied ? "badge-warn" : "badge-err";
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", $"badge {css}");
        builder.AddContent(3, status.ToString());
        builder.CloseElement();
    };

    private async Task ExportJson()
    {
        var all = await AuditQuery.QueryAsync(BuildFilter(1, 5000), CancellationToken.None);
        var json = System.Text.Json.JsonSerializer.Serialize(all.Items, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await Download($"audit-{DateTime.UtcNow:yyyyMMdd-HHmmss}.json", "application/json", json);
    }

    private async Task ExportCsv()
    {
        var all = await AuditQuery.QueryAsync(BuildFilter(1, 5000), CancellationToken.None);
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("timestamp,origin,caller,callerRoles,tool,detail,status,durationMs,redactedResponse");
        foreach (var e in all.Items)
        {
            sb.Append(e.Timestamp.UtcDateTime.ToString("O", CultureInfo.InvariantCulture)).Append(',')
              .Append(e.Origin).Append(',')
              .Append(e.Caller?.ToString() ?? "").Append(',')
              .Append(Csv(e.CallerRoles)).Append(',')
              .Append(Csv(e.Tool)).Append(',')
              .Append(Csv(e.Detail)).Append(',')
              .Append(e.Status?.ToString() ?? "").Append(',')
              .Append((e.Duration?.TotalMilliseconds ?? 0).ToString("0", CultureInfo.InvariantCulture)).Append(',')
              .Append(Csv(e.RedactedResponse?.GetRawText()))
              .AppendLine();
        }
        await Download($"audit-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv", "text/csv", sb.ToString());
    }

    // Detail/CallerRoles sind Freitext: neben Kommas müssen auch Anführungszeichen und Zeilenumbrüche
    // quotiert werden, sonst zerreißt der Export die Spalten.
    private static string Csv(string? value)
        => value is null ? ""
            : value.AsSpan().IndexOfAny(",\"\r\n") >= 0 ? $"\"{value.Replace("\"", "\"\"")}\"" : value;

    private async Task Download(string filename, string mime, string content)
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(content);
        await JS.InvokeVoidAsync("bifrostDownload", filename, mime, Convert.ToBase64String(bytes));
    }
}
