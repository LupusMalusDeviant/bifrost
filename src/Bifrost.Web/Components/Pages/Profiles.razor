@page "/profiles"
@attribute [Authorize(Policy = UiPolicies.Admin)]
@inject IRbacManagement Rbac
@inject IToolCatalog Catalog
@inject IAuditSink Audit
@inject IAuditQuery AuditQuery
@inject TimeProvider Time
@inject AuthenticationStateProvider AuthState

<h1>Profile &amp; Token-Cockpit</h1>
<p class="muted">Pro Profil: welche Tools gepinnt sind und wie viele Kontext-Tokens das kostet (FR-15/38, ADR-0003).</p>

<div class="card">
    <div class="stat-label">Voll-Exposition aller Tools</div>
    <div class="stat">@_fullTokens<span class="muted" style="font-size:1rem"> Tokens</span></div>
    <div class="muted">So viel Kontext kostet ein Agent ohne Profil, der alle @_toolCount Tools voll sähe — die Vergleichsbasis für die ≥ 80 %-Ersparnis (Z-2).</div>
</div>

<div class="card">
    @* Ein Tabellenkopf ohne eine einzige Zeile darunter sieht aus wie ein Fehler — und sagt
       ausgerechnet dann nichts, wenn jemand zum ersten Mal hier ist. *@
    @if (_profiles.Count == 0)
    {
        <div class="empty">
            <strong>Noch kein Profil angelegt.</strong>
            <p class="muted" style="margin:.35rem 0 0">
                Ohne Profil bekommt ein Agent die sparsame Default-Sicht: die Meta-Tools statt
                aller Schemata. Ein Profil lohnt sich, sobald ein Agent einzelne Werkzeuge
                <em>ständig</em> braucht — die kommen dann mit vollem Schema, der Rest bleibt
                über <span class="mono">search_tools</span> erreichbar.
            </p>
        </div>
    }
    else
    {
    <div class="table-wrap">
        <table>
            <thead><tr><th>Profil</th><th>Pinned</th><th>Lazy</th><th>Geschätzte Tokens</th><th>Ersparnis</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in _profiles)
                {
                    var tokens = EstimateTokens(p);
                    <tr>
                        <td class="mono">@p.Name</td>
                        <td>@p.PinnedTools.Count</td>
                        <td>@(p.LazyToolsEnabled ? "an" : "aus")</td>
                        <td>@tokens</td>
                        <td>@Savings(tokens)</td>
                        <td><ConfirmButton What="@p.Name" OnConfirmed="() => Remove(p.Id)" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
</div>

<div class="card">
    <h3 style="margin-top:0">Call-Volumen (letzte 14 Tage)</h3>
    <p class="muted">Token-Ersparnis wirkt nur, wenn auch Calls anfallen — der Trend zeigt, worauf sich die Schätzung bezieht (FR-38).</p>
    @if (_trend.Count == 0 || _trend.All(d => d.Calls == 0))
    {
        <p class="muted">Noch keine Calls im Zeitraum.</p>
    }
    else
    {
        @* Vierzehn Zeilen mit meist einer Null darin waren ein Diagramm, das als Tabelle
           gerendert wurde: viel Platz, wenig Aussage, und der Verlauf — das Einzige, worum es
           hier geht — musste im Kopf zusammengesetzt werden. Als Balkenreihe steht er in einer
           Zeile. Der genaue Wert hängt am Titel jedes Balkens; die Tabelle war der falsche Ort
           für eine Form, keine für eine Zahl.

           Balken von Hand statt Diagramm-Bibliothek: eine Abhängigkeit weniger für dieselbe
           Aussage — und in einer Oberfläche, die keine externen Ressourcen lädt, ohnehin die
           einzige Möglichkeit. *@
        <div class="spark" role="img"
             aria-label="@($"Calls je Tag, {_trend[0].Date:yyyy-MM-dd} bis {_trend[^1].Date:yyyy-MM-dd}, Maximum {_trend.Max(d => d.Calls)}")">
            @foreach (var day in _trend)
            {
                <div class="spark-col" title="@day.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture): @day.Calls Calls">
                    <div class="spark-bar @(day.Calls == 0 ? "is-zero" : null)" style="height:@(BarWidth(day.Calls))%"></div>
                </div>
            }
        </div>
        <div class="spark-axis">
            <span>@_trend[0].Date.ToString("dd.MM.", CultureInfo.InvariantCulture)</span>
            <span>Spitze: @_trend.Max(d => d.Calls) Calls/Tag</span>
            <span>@_trend[^1].Date.ToString("dd.MM.", CultureInfo.InvariantCulture)</span>
        </div>
    }
</div>

<div class="card">
    <h3 style="margin-top:0">Neues Profil</h3>
    <div class="row">
        <div><label>Name</label><input @bind="_name" /></div>
        <div style="flex:0; min-width:200px"><label><input type="checkbox" @bind="_lazy" /> Lazy-Meta-Tools aktiv</label></div>
    </div>
    <label>Pinned-Tools (ein Namespaced-Name pro Zeile — voll sichtbar mit Schema)</label>
    <textarea class="mono" rows="4" @bind="_pinned" placeholder="github__create_issue"></textarea>
    <p class="muted" style="margin:.4rem 0">Vorschau: @EstimateFromInputs() Tokens</p>
    <div class="toolbar">
        <button @onclick="Add">Profil anlegen</button>
        @if (_msg is not null) { <span class="@(_ok ? "msg-ok" : "msg-err")">@_msg</span> }
    </div>
</div>

@code {
    private IReadOnlyList<ToolProfile> _profiles = [];
    private int _fullTokens, _toolCount;
    private string _name = "", _pinned = ""; private bool _lazy = true, _ok; private string? _msg;

    protected override async Task OnInitializedAsync() => await Reload();

    private sealed record DayVolume(DateTime Date, long Calls);

    private List<DayVolume> _trend = [];

    private async Task Reload()
    {
        _profiles = await Rbac.ListProfilesAsync(CancellationToken.None);
        var tools = Catalog.Snapshot.Where(e => e.Kind == CatalogEntryKind.Tool).ToList();
        _toolCount = tools.Count;
        _fullTokens = tools.Sum(t => t.EstimatedSchemaTokens);
        await LoadTrendAsync();
    }

    private async Task LoadTrendAsync()
    {
        // Pro Tag eine Count-Abfrage (PageSize 1, nur TotalCount zählt) statt alle Events zu laden —
        // 14 billige Aggregat-Queries schlagen einen Full-Scan über zwei Wochen Audit-Log.
        var today = Time.GetUtcNow().UtcDateTime.Date;
        var days = new List<DayVolume>(14);
        for (var offset = 13; offset >= 0; offset--)
        {
            var from = new DateTimeOffset(today.AddDays(-offset), TimeSpan.Zero);
            var result = await AuditQuery.QueryAsync(
                new AuditFilter(From: from, To: from.AddDays(1), Kind: AuditEventKind.ToolCall, PageSize: 1),
                CancellationToken.None);
            days.Add(new DayVolume(from.UtcDateTime, result.TotalCount));
        }

        _trend = days;
    }

    private int BarWidth(long calls)
    {
        var max = _trend.Count == 0 ? 0 : _trend.Max(d => d.Calls);
        return max <= 0 ? 0 : (int)Math.Round(100.0 * calls / max);
    }

    /// <summary>
    /// Kontextkosten eines Profils. Bewusst <b>ohne</b> RBAC-Filter: Ein Profil gehört keiner
    /// einzelnen Identität, also ist das die nominale Größe. Was ein konkreter Agent bekommt, kann
    /// kleiner sein, wenn ihm Grants für gepinnte Tools fehlen — dieselbe Formel, andere Menge
    /// (<c>IToolCatalog.GetViewFor</c>).
    /// </summary>
    private int EstimateTokens(ToolProfile p)
        => Bifrost.Core.Catalog.ToolCatalog.EstimateContextTokens(
            p.PinnedTools.Select(n => Catalog.Find(n)).Where(e => e is not null).Select(e => e!),
            p.LazyToolsEnabled);

    private int EstimateFromInputs()
    {
        var pinnedTokens = _pinned.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(n => Catalog.Find(new NamespacedToolName(n)))
            .Where(e => e is not null)
            .Sum(e => e!.EstimatedSchemaTokens);
        return pinnedTokens + (_lazy ? Bifrost.Core.Catalog.ToolCatalog.MetaToolTokenEstimate : 0);
    }

    private string Savings(int tokens)
        => _fullTokens > 0 ? $"{100.0 * (_fullTokens - tokens) / _fullTokens:0.0}%" : "—";

    private async Task<string> UserAsync()
        => (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "?";

    private async Task Add()
    {
        _msg = null;
        if (string.IsNullOrWhiteSpace(_name)) { _ok = false; _msg = "Name fehlt."; return; }
        var pins = _pinned.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(n => new NamespacedToolName(n)).ToList();
        try
        {
            await Rbac.UpsertProfileAsync(new ToolProfile(ProfileId.New(), _name.Trim(), pins, _lazy), CancellationToken.None);
            UiAudit.Record(Audit, Time, await UserAsync(), AuditEventKind.RbacChanged, $"profile-added:{_name}");
            _ok = true; _msg = "Profil angelegt."; _name = ""; _pinned = "";
            await Reload();
        }
        catch (Exception ex) { _ok = false; _msg = ex.Message; }
    }

    private async Task Remove(ProfileId id)
    {
        await Rbac.RemoveProfileAsync(id, CancellationToken.None);
        UiAudit.Record(Audit, Time, await UserAsync(), AuditEventKind.RbacChanged, "profile-removed");
        await Reload();
    }
}
