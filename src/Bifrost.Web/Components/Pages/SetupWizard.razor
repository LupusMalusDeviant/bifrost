            <div class="toolbar" style="margin-top:.75rem">
                <button class="btn-ghost" @onclick="RefreshFactsAsync" disabled="@_busy">Zustand neu lesen</button>
                @if (_shownSlug is { } slug)
                {
                    <span class="muted">Zeitlinie für <span class="mono">@slug</span></span>
                }
