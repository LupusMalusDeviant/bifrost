                                    }
                                    else
                                    {
                                        <button class="btn-sm btn-ghost" disabled="@_busy"
                                                @onclick="() => SetEnabledAsync(upstream, false)">Abschalten</button>
                                    }
                                    <button class="btn-sm btn-ghost" disabled="@_busy"
                                            @onclick="() => DiagnoseAsync(upstream)">Zeitlinie</button>
                                </td>
                            </tr>
