                    <tbody>
                        @foreach (var upstream in _facts.Upstreams)
                        {
                            <tr>
                                <td class="mono">@upstream.Slug</td>
                                <td><span class="badge @StateCss(upstream.State)">@upstream.State</span></td>
                                <td>@upstream.ToolCount</td>
                                <td class="muted cell-clamp"><div class="clamp-3">@(upstream.LastError ?? "—")</div></td>
                                <td class="col-actions">
                                    @if (upstream.State == nameof(UpstreamState.Stopped))
                                    {
