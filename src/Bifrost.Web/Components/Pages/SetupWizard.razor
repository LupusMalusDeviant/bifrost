    private RenderFragment StepConnection => @<div class="card">
        <h2 style="margin-top:0">6 · Verbindung und Discovery</h2>
        <p class="muted" style="margin-top:0">
            Die Prüfung läuft denselben Weg wie das Anschließen: Validator, Torposten, Verbindung,
