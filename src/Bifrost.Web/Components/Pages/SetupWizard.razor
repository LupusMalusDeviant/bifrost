    private static RenderFragment Finding(ImportFinding finding) => @<div class="wizard-finding sev-@finding.Severity">
        <span class="code">@finding.Code · @finding.Severity</span>
        @if (finding.Path is { } path)
        {
            <span class="code"> · @path</span>
        }
        <div>@finding.Summary</div>
        @if (finding.Remediation is { } remediation)
        {
            <div class="muted">@remediation</div>
        }
    </div>;

    private void Toggle(string sourceName, bool on)
    {
        if (_session is not { } session)
        {
            return;
        }

        if (on)
        {
            session.Selected.Add(sourceName);
        }
        else
        {
            session.Selected.Remove(sourceName);
        }

        // Die Bestaetigung faellt bei jeder Aenderung der Auswahl weg: Sie galt fuer die alte
        // Auswahl, und eine Bestaetigung, die eine andere Menge meint als die angelegte, ist keine.
        session.RisksConfirmed = false;
        Sessions.Touch(session);
    }

    private void Confirm(bool on)
    {
        if (_session is { } session)
        {
            session.RisksConfirmed = on;
            Sessions.Touch(session);
        }
    }

    private async Task ApplyAsync()
    {
        if (_session is not { } session)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            session.ContainerImage = string.IsNullOrWhiteSpace(_image) ? null : _image.Trim();
            var report = await Wizard.ApplySelectionAsync(
                session, session.Owner ?? "anonym", CancellationToken.None);
            Sessions.Touch(session);
            _facts = await Wizard.ReadFactsAsync(CancellationToken.None);

            if (report.Refusal is { } refusal)
            {
                _ok = false;
                _message = refusal;
                return;
            }

            _ok = report.Created.Count > 0;
            _message = report.Skipped.Count == 0
                ? $"{report.Created.Count} Server angelegt."
                : $"{report.Created.Count} angelegt, {report.Skipped.Count} ausgelassen — die Gründe stehen unten.";
        }
        finally
        {
            _busy = false;
        }
    }

