@* Die Route steht als Zeichenkette auch in UiNavigation.SetupWizardRoute — dort mit der
   Begruendung, warum sie NICHT unter /setup/ haengt. Razor nimmt an dieser Stelle nur eine
   Konstante aus einem Literal; ein Test haelt beide gegeneinander. *@
@page "/first-run"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using System.Text.Json
@using Bifrost.Abstractions.Importing
@using Bifrost.Abstractions.Setup
@using Bifrost.Core
@using Bifrost.Core.Diagnostics.Upstreams
@inject ISetupWizard Wizard
@inject ISetupSessionStore Sessions
@inject IUpstreamSupervisor Supervisor
@inject IUpstreamConfigStore ConfigStore
@inject IUpstreamConnectionDiagnostics ConnectionDiagnostics
@inject IRbacManagement Rbac
@inject IApiKeyService ApiKeys
@inject IToolCatalog Catalog
@inject IToolInvoker Invoker
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime Js

@*
    Der gefuehrte Erstaufbau (WP4.4, FR-P012).

    DREI DINGE, DIE HIER NICHT PASSIEREN — und die den Bau bestimmen:

    1. KEIN HTTP-AUFRUF GEGEN DEN SETUP-ENDPUNKT. Diese Seite ist Blazor Interactive Server und
       laeuft IM Serverprozess. Sie ruft den Wizard-Dienst direkt auf, und der ruft Importer und
       Vorschauprojektion. '/setup/import/preview' bleibt auf Loopback beschraenkt und ist fuer
       lokale Werkzeuge da (docs/plans/product-readiness-status.md).

    2. KEINE KERNREGEL. Was anwendbar ist, sagt der Plan; was bestaetigt werden muss, sagt
       ConfirmationsFor; was sicher voreingestellt wird, sagt SecureUpstreamDefaults; ob etwas nativ
       laufen darf, sagt die Ausfuehrungs-Policy. Diese Seite stellt dar und fragt.

    3. KEIN ZUSTAND IM BROWSER ausser der Kennung. Der Vorgang liegt serverseitig; die Kennung
       steht in einem Cookie, nicht in der Adresszeile. Und der ausgestellte API-Key liegt in
       KEINER Ablage — er lebt nur in diesem Circuit und ist nach einem Neuladen weg. Dann steht
       dort ein Knopf, der einen neuen ausstellt, statt einer Ausrede.
*@

<div class="wizard">
    <div class="wizard-head">
        <BrandMark Tagline="Einrichtung in neun Schritten." />
        <div style="flex:1; min-width:240px">
            <h1 style="margin:0">Erstaufbau</h1>
            <p class="muted" style="margin:.2rem 0 0">
                Vom leeren Gateway bis zum ersten echten Toolaufruf — ohne eine Konfigurationsdatei
                von Hand anzufassen.
            </p>
        </div>
    </div>
    <div class="wizard-rule" style="margin:.9rem 0 0"></div>

    <ol class="wizard-steps" aria-label="Fortschritt der Einrichtung">
        @foreach (var step in AllSteps)
        {
            <li data-state="@StepState(step)"
                aria-current="@(step == Current ? "step" : null)">
                <span class="n">@((int)step)</span>
                <span>@Title(step)</span>
            </li>
        }
    </ol>

    @if (_notice is not null)
    {
        <div class="card" role="status">
            <strong>Hinweis</strong>
            <p class="muted" style="margin:.3rem 0 0">@_notice</p>
        </div>
    }

    @if (_facts is null)
    {
        <div class="card"><p class="muted" style="margin:0">Lese den Zustand dieser Instanz …</p></div>
    }
    else
    {
        @switch (Current)
        {
            case SetupStep.SecurityMode: @StepSecurityMode; break;
            case SetupStep.AdminAccess: @StepAdminAccess; break;
            case SetupStep.KeyRing: @StepKeyRing; break;
            case SetupStep.Source: @StepSource; break;
            case SetupStep.ImportReview: @StepImportReview; break;
            case SetupStep.Connection: @StepConnection; break;
            case SetupStep.Agent: @StepAgent; break;
            case SetupStep.Snippet: @StepSnippet; break;
            case SetupStep.TestCall: @StepTestCall; break;
        }

        <div class="wizard-nav">
            <button class="btn-ghost" @onclick="Back" disabled="@(!CanGoBack)">Zurück</button>
            @* Auf dem letzten Schritt gibt es kein „Weiter". Ein Knopf, der grundsaetzlich nichts
               tut, ist schlechter als keiner: Er laesst offen, ob man etwas falsch gemacht hat. *@
            @if (Current is not SetupStep.TestCall)
            {
                <button @onclick="Forward" disabled="@_busy">@ForwardLabel</button>
            }
            <span class="spacer"></span>
            @if (_message is not null)
            {
                <span class="@(_ok ? "msg-ok" : "msg-err")" role="alert">@_message</span>
            }
            <a class="btn btn-ghost btn-sm" href="/">Zur Oberfläche</a>
            <button class="btn-ghost btn-sm" @onclick="Abort">Einrichtung abbrechen</button>
        </div>
    }
</div>

@code {
    // ── Zustand dieses Circuits ─────────────────────────────────────────────────────────────────
    // Was hier steht, ist entweder aus der Instanz gelesen (_facts) oder darf verloren gehen
    // (_key). Alles, was einen Neustart des Browsers ueberleben muss, liegt in _session.

    private SetupSession? _session;
    private SetupFacts? _facts;
    private string? _notice, _message;
    private bool _ok, _busy;

    /// <summary>Der ausgestellte Schlüssel — <b>nur hier</b>, nie in der Ablage. Siehe Kopf.</summary>
    private string? _key;
    private IReadOnlyList<ClientConfigSnippet> _snippets = [];
    private string? _snippetHint;

    // Schritt 1
    private string _image = "";

    // Schritt 4
    private string _document = "", _documentName = "";
    private string _manualSlug = "", _manualUrl = "", _manualCommand = "", _manualArgs = "";
    private UpstreamTransportKind _manualKind = UpstreamTransportKind.StreamableHttp;
    private bool _manualAllowPrivate;

    // Schritt 6
    private UpstreamDiagnosticReport? _shownReport;
    private string? _shownSlug;

    // Schritt 7
    private string _agentName = "erster-agent";
    private bool _globalGrant;

    // Schritt 9
    private string _testTool = "", _testArgs = "{}";

    private static readonly SetupStep[] AllSteps = Enum.GetValues<SetupStep>();

    private SetupStep Current => _session?.Step ?? SetupStep.SecurityMode;

    // ── Aufbau und Fortsetzen ───────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
        => _facts = await Wizard.ReadFactsAsync(CancellationToken.None);

    /// <summary>
    /// Die Kennung liegt in einem Cookie und ist deshalb erst nach dem ersten Rendern lesbar —
    /// waehrend des Prerenders gibt es keinen Browser, den man fragen koennte. Der kurze Moment
    /// „Lese den Zustand dieser Instanz …" ist genau dieser Umstand und keine Ladeanimation.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var handle = await Js.InvokeAsync<string?>("bifrostSetup.read");
        var owner = await UserAsync();
        var resumed = Sessions.Reopen(handle, owner);

        if (resumed.Session is { } session)
        {
            _session = session;
        }
        else
        {
            _notice = resumed.Reason;
            _session = Sessions.Start();
            await Js.InvokeVoidAsync("bifrostSetup.write", _session.Handle);
        }

        _facts = await Wizard.ReadFactsAsync(CancellationToken.None);
        Adopt(owner);
        StateHasChanged();
    }

    private async Task<string?> UserAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return state.User.Identity?.IsAuthenticated == true ? state.User.Identity.Name : null;
    }

    /// <summary>
    /// Bringt den gespeicherten Schritt mit der Wirklichkeit in Einklang — und sagt es, wenn er
    /// dabei zurueckgesetzt wird.
    /// <para>
    /// <b>Das ist die Fortsetzen-Semantik.</b> Der Vorgang merkt sich, wo jemand war; ob er dort
    /// noch stehen darf, entscheidet die Instanz. Wer den Browser schliesst und wiederkommt, steht
    /// dort, wo er war — es sei denn, die Lage hat sich geaendert, und dann steht hier warum.
    /// </para>
    /// </summary>
    private void Adopt(string? owner)
    {
        if (_session is not { } session || _facts is not { } facts)
        {
            return;
        }

        if (owner is { Length: > 0 })
        {
            session.Owner = owner;
        }

        // Die Regel steht in SetupProgress und nicht hier: Sie ist die Antwort auf „kommt der Nutzer
        // weiter oder steht er?", und die muss ohne Browser pruefbar sein.
        var (step, reason) = SetupProgress.Normalise(session, facts, owner is { Length: > 0 });
        session.Step = step;

        // Kein stilles Zurueckspringen: Wenn zurueckgesetzt wurde, steht hier der Grund — sonst
        // denkt der Nutzer, der Wizard habe seine Arbeit verloren.
        _notice = reason ?? _notice;

        _agentName = session.AgentName ?? _agentName;
        _image = session.ContainerImage ?? _image;
        Sessions.Touch(session);
    }

    private string StepState(SetupStep step)
        => step < Current ? "done" : step == Current ? "current" : "open";

    private static string Title(SetupStep step) => step switch
    {
        SetupStep.SecurityMode => "Betriebsart",
        SetupStep.AdminAccess => "Zugang",
        SetupStep.KeyRing => "Schlüsselring",
        SetupStep.Source => "Quelle",
        SetupStep.ImportReview => "Befunde",
        SetupStep.Connection => "Verbindung",
        SetupStep.Agent => "Agent",
        SetupStep.Snippet => "Client",
        _ => "Testaufruf",
    };

    // ── Navigation ──────────────────────────────────────────────────────────────────────────────

    private bool CanGoBack => _session is { Step: > SetupStep.SecurityMode } && !_busy;

    private string ForwardLabel => Current is SetupStep.Snippet ? "Zum Testaufruf" : "Weiter";

    private void Back()
    {
        if (_session is not { } session || session.Step is SetupStep.SecurityMode)
        {
            return;
        }

        _message = null;
        session.Step = (SetupStep)((int)session.Step - 1);
        Sessions.Touch(session);
    }

    /// <summary>
    /// Ein Schritt weiter — <b>wenn</b> dieser Schritt fertig ist. Was „fertig" heisst, steht je
    /// Schritt in <see cref="Blocker"/>; die Absage nennt den Grund, statt den Knopf tot zu
    /// stellen. Ein toter Knopf ohne Erklaerung ist die Bauform, an der Leute abbrechen.
    /// </summary>
    private void Forward()
    {
        if (_session is not { } session || _facts is not { } facts)
        {
            return;
        }

        _message = null;
        if (SetupProgress.BlockerFor(session, facts, session.Owner is { Length: > 0 }) is { } reason)
        {
            _ok = false;
            _message = reason;
            return;
        }

        _notice = null;
        session.Step = SetupProgress.Next(session);
        Sessions.Touch(session);
    }

    private async Task Abort()
    {
        if (_session is { } session)
        {
            Sessions.Discard(session.Handle);
        }

        await Js.InvokeVoidAsync("bifrostSetup.clear");
        Nav.NavigateTo("/", forceLoad: true);
    }

    // ── Schritt 1: Betriebsart ──────────────────────────────────────────────────────────────────

    private RenderFragment StepSecurityMode => @<div class="card">
        <h2 style="margin-top:0">1 · Was soll diese Instanz sein?</h2>
        <p class="muted" style="margin-top:0">
            Die Wahl entscheidet, was in den folgenden Schritten voreingestellt ist —
            <strong>nicht</strong>, was erlaubt ist. Erlaubt wird von der Ausführungs-Policy und dem
            Validator entschieden, und die sitzen im Kern.
        </p>

        <div class="pill-list" style="margin:.6rem 0 .2rem" role="radiogroup" aria-label="Betriebsart">
            <label class="pill" style="padding:.35rem .8rem">
                <input type="radio" name="mode" checked="@(_session?.Mode is SetupSecurityMode.Shielded)"
                       @onchange="() => SetMode(SetupSecurityMode.Shielded)" />
                Abgeschirmt (empfohlen)
            </label>
            <label class="pill" style="padding:.35rem .8rem">
                <input type="radio" name="mode" checked="@(_session?.Mode is SetupSecurityMode.Workbench)"
                       @onchange="() => SetMode(SetupSecurityMode.Workbench)" />
                Lokale Werkbank
            </label>
        </div>

        <RiskHint Title="Was die beiden Betriebsarten unterscheiden"
                  WhenOn="@("Abgeschirmt: Ein Server, der ein Programm startet, läuft im Container. Er kommt an das, was der Container ihm gibt — nicht an den Rest der Maschine und nicht an den Schlüsselring. Dafür braucht jeder solche Server ein Image.")"
                  WhenOff="@("Lokale Werkbank: Programme laufen mit den Rechten des Gateways. Sie können alles lesen, was diesem Benutzer offensteht, einschließlich der API-Keys aller Agenten und der Secrets aller anderen Upstreams.")"
                  Noticed="@("Beim Anlegen steht die Betriebsart in der Konfigurationsversion; danach nichts mehr. Ein Zugriff des Programms auf Dateien der Maschine erscheint in keinem Log dieses Gateways.")" />

        @if (_session?.Mode is SetupSecurityMode.Shielded)
        {
            <label for="wizard-image">
                Container-Image für Server, die ein Programm starten (optional, wird pro Server
                übernommen)
            </label>
            <input id="wizard-image" @bind="_image" @bind:event="oninput"
                   placeholder="ghcr.io/beispiel/server@@sha256:…" />
            <p class="muted" style="margin:.3rem 0 0">
                Ohne Image weist der Validator einen Server ab, der im Container laufen soll —
                <span class="mono">Isolation.Image</span> ist dort Pflicht. Server ohne eigenes
                Programm (Streamable HTTP, OpenAPI) brauchen keines.
            </p>
        }

        <h3>Was diese Instanz tatsächlich zulässt</h3>
        <div class="table-wrap">
            <table>
                <tbody>
                    <tr>
                        <th style="width:220px">Native Ausführung</th>
                        <td>
                            <span class="badge @(_facts!.Execution.Allowed ? "badge-warn" : "badge-ok")">
                                @(_facts.Execution.Allowed ? "erlaubt" : "verboten")
                            </span>
                            <span class="mono muted" style="margin-left:.4rem">@_facts.Execution.ReasonCode</span>
                            <div class="muted">@_facts.Execution.Summary</div>
                            @if (_facts.Execution.Remediation is { } remedy)
                            {
                                <div class="muted">@remedy</div>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Schlüsselring</th>
                        <td>
                            <span class="mono">@_facts.KeyRing.Mode</span>
                            <div class="muted">@_facts.KeyRing.Summary</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        @if (_session?.Mode is SetupSecurityMode.Workbench && !_facts.Execution.Allowed)
        {
            <p class="msg-err" style="margin-bottom:0">
                Diese Instanz verbietet native Ausführung. Ein Server, der ein Programm startet,
                wird in Schritt 4 abgewiesen — mit der Begründung aus dem Kern. Wer das ändern will,
                setzt <span class="mono">@_facts.Execution.SwitchName</span> und startet neu.
            </p>
        }
    </div>;

    private void SetMode(SetupSecurityMode mode)
    {
        if (_session is not { } session)
        {
            return;
        }

        session.Mode = mode;
        Wizard.Record(session.Owner ?? "anonym", $"Setup-Wizard: Betriebsart '{mode}' gewaehlt.");
        Sessions.Touch(session);
    }

    // ── Schritt 2: Zugang ───────────────────────────────────────────────────────────────────────

    private RenderFragment StepAdminAccess => @<div class="card">
        <h2 style="margin-top:0">2 · Zugang anlegen</h2>
        @if (_facts!.Access.AnyAdmin && _session?.Owner is { } owner)
        {
            <p class="msg-ok" style="margin-top:0">
                Angemeldet als <strong>@owner</strong>. Der Erstzugang ist erledigt — ab hier legt
                der Wizard Dinge an, und zwar unter diesem Namen.
            </p>
            <p class="muted" style="margin-bottom:0">
                Ein zweites Setup-Token gibt es nur mit lokalem Nachweis auf dem Rechner, auf dem
                der Gateway läuft. Weitere UI-Zugänge später unter
                <a href="/users">UI-Nutzer</a>.
            </p>
        }
        else if (_facts.Access.AnyAdmin)
        {
            <p class="muted" style="margin-top:0">@_facts.Access.Summary</p>
            <p style="margin-bottom:0">
                <a class="btn" href="@($"/login?returnUrl={Uri.EscapeDataString(UiNavigation.SetupWizardRoute)}")">
                    Anmelden und hierher zurück
                </a>
            </p>
        }
        else if (_facts.Access.Pending)
        {
            <p class="muted" style="margin-top:0">
                Beim ersten Start legt der Gateway ein Setup-Token an und schreibt es in
                <code>&lt;datadir&gt;/config/bootstrap-token.txt</code> — nicht ins Log. Im Container:
                <code>docker compose exec bifrost cat /data/config/bootstrap-token.txt</code>.
                @if (_facts.Access.ExpiresAt is { } expires)
                {
                    <text> Es gilt bis @expires.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) UTC.</text>
                }
            </p>
            @*
                Nativer Form-POST, genau wie /setup und /login: Am Ende dieses Vorgangs wird ein
                Cookie gesetzt, und ein Blazor-Circuit kann das nicht. Der Rueckweg fuehrt hierher —
                geprueft wird er serverseitig mit derselben Funktion wie beim Login.
            *@
            <form action="/auth/setup" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@UiNavigation.SetupWizardRoute" />
                <label for="wizard-token">Setup-Token</label>
                <input id="wizard-token" name="token" autocomplete="off" autofocus />
                <label for="wizard-user">Benutzername</label>
                <input id="wizard-user" name="username" autocomplete="username" />
                <label for="wizard-password">Passwort (mindestens 12 Zeichen)</label>
                <input id="wizard-password" name="password" type="password" autocomplete="new-password" />
                <button type="submit" style="margin-top:1rem">Zugang anlegen</button>
            </form>
            @if (Failed is not null)
            {
                <p class="msg-err" style="margin-bottom:0">@BootstrapReason(Failed)</p>
            }
        }
        else
        {
            <p class="msg-err" style="margin-top:0">@_facts.Access.Summary</p>
            <p class="muted" style="margin-bottom:0">
                Der Wizard stellt kein Token aus. Das ist Absicht: Ein zweites Token gibt es nur mit
                lokalem Nachweis auf dem Rechner, auf dem der Gateway läuft — sonst wäre der
                Erstzugang über das Netz zurückdrehbar.
            </p>
        }
    </div>;

    [SupplyParameterFromQuery(Name = "failed")]
    public string? Failed { get; set; }

    // Derselbe Textvorrat wie auf /setup: Der Grund kommt als Code aus der Adresszeile, angezeigt
    // wird ausschliesslich ein Text aus dieser Liste. Fremde Inhalte erreichen die Seite nicht.
    private static string BootstrapReason(string code) => code switch
    {
        "NotPending" => "Es steht kein Erstzugang aus — entweder ist er schon eingelöst, oder diese "
            + "Installation hatte bereits Zugänge.",
        "Expired" => "Die Frist des Setup-Tokens ist verstrichen; es ist entwertet. Ein neues stellt "
            + "der nächste Start aus, solange noch niemand eingerichtet ist.",
        "InvalidToken" => "Das Setup-Token passt nicht.",
        "UsernameTaken" => "Dieser Benutzername ist vergeben.",
        "PasswordTooShort" => "Das Passwort ist zu kurz — mindestens 12 Zeichen.",
        "CredentialsMissing" => "Benutzername und Passwort sind Pflicht.",
        _ => "Der Erstzugang konnte nicht eingerichtet werden.",
    };

    // ── Schritt 3: Schlüsselring ────────────────────────────────────────────────────────────────

    private RenderFragment StepKeyRing => @<div class="card">
        <h2 style="margin-top:0">3 · Schlüsselring</h2>
        <p class="muted" style="margin-top:0">
            Der Schlüsselring entschlüsselt <strong>sämtliche</strong> Upstream-Zugangsdaten,
            OAuth-Token und Webhook-Secrets dieser Instanz. Wie er geschützt wird, entscheidet die
            Umgebung des Prozesses — deshalb steht hier eine Auskunft und kein Formular. Eine
            Oberfläche, die das ändern könnte, wäre ein Weg, den Schutz aus der Ferne abzuschalten.
        </p>
        <div class="table-wrap">
            <table>
                <tbody>
                    <tr><th style="width:200px">Betriebsart</th><td class="mono">@_facts!.KeyRing.Mode</td></tr>
                    <tr>
                        <th>Erklärt</th>
                        <td>
                            <span class="badge @(_facts.KeyRing.Declared ? "badge-ok" : "badge-warn")">
                                @(_facts.KeyRing.Declared ? "ja" : "nein")
                            </span>
                        </td>
                    </tr>
                    <tr><th>Urteil beim Start</th><td>@(_facts.KeyRing.Verdict ?? "—")</td></tr>
                    <tr><td colspan="2">@_facts.KeyRing.Summary</td></tr>
                    @if (_facts.KeyRing.Remediation is { } remedy)
                    {
                        <tr><td colspan="2" class="muted">@remedy</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!_facts.KeyRing.Declared)
        {
            <RiskHint Title="Was ein unerklärter Schlüsselring bedeutet"
                      WhenOn="@("Mit einem Zertifikat liegt der Ring verschlüsselt. Wer das Datenverzeichnis kopiert, hat damit noch nichts.")"
                      WhenOff="@("Ohne Zertifikat liegt der Ring im Klartext neben der Datenbank. Wer Lesezugriff auf das Datenverzeichnis hat — eine Sicherung, ein Volume-Snapshot, ein Container mit demselben Mount — kann jedes gespeicherte Zugangsdatum entschlüsseln.")"
                      Noticed="@("Niemand. Es gibt keinen Zugriff, der auffiele: Die Entschlüsselung passiert außerhalb dieses Gateways und hinterlässt hier keine Spur.")" />
            <p class="muted">
                Entweder ein Zertifikat einrichten
                (<span class="mono">@_facts.KeyRing.CertificatePathSetting</span>) oder den
                ungeschützten Betrieb ausdrücklich wählen
                (<span class="mono">@_facts.KeyRing.ProtectionSetting=@_facts.KeyRing.NoneValue</span>).
                Beides gilt erst nach einem Neustart des Prozesses.
            </p>
            <label>
                <input type="checkbox" checked="@(_session?.KeyRingAcknowledged == true)"
                       @onchange="AcknowledgeKeyRing" />
                Ich habe gelesen, dass der Schlüsselring hier ungeschützt liegt, und richte den
                Schutz nach der Einrichtung ein.
            </label>
        }
        else
        {
            <p class="msg-ok" style="margin-bottom:0">
                Die Betriebsart ist erklärt. Nichts zu tun.
            </p>
        }
    </div>;

    private void AcknowledgeKeyRing(ChangeEventArgs args)
    {
        if (_session is not { } session)
        {
            return;
        }

        session.KeyRingAcknowledged = args.Value is true;
        if (session.KeyRingAcknowledged)
        {
            // In den Audit, nicht nur in den Sitzungszustand: Wer spaeter fragt, warum diese Instanz
            // ohne Zertifikat laeuft, findet hier den Namen und den Zeitpunkt.
            Wizard.Record(
                session.Owner ?? "anonym",
                "Setup-Wizard: ungeschuetzter Key-Ring ausdruecklich zur Kenntnis genommen.");
        }

        Sessions.Touch(session);
    }

    // ── Schritt 4: Quelle ───────────────────────────────────────────────────────────────────────

    private RenderFragment StepSource => @<div>
        <div class="card">
            <h2 style="margin-top:0">4 · Woher kommt der erste Server?</h2>
            <p class="muted" style="margin-top:0">
                Eine vorhandene Konfiguration aus Claude, Cursor, VS Code, Codex oder einer
                generischen <span class="mono">mcp.json</span> einlesen — oder einen Server von Hand
                beschreiben. Eingelesen heißt <strong>angesehen</strong>: Es entsteht ein Plan, und
                der ist keine Änderung.
            </p>

            <label for="wizard-file">Konfigurationsdatei</label>
            <InputFile id="wizard-file" OnChange="ReadFileAsync" accept=".json,.toml,application/json" />
            <p class="muted" style="margin:.3rem 0 0">
                Höchstens @(Wizard.MaxDocumentBytes / 1024) KiB — dieselbe Grenze wie an der
                Schnittstelle. Die Datei wird im Browser gelesen und als Text übertragen; der Server
                öffnet keinen Pfad, den ein Client ihm nennt.
            </p>

            <label for="wizard-doc">… oder Inhalt einfügen</label>
            <textarea id="wizard-doc" class="mono" rows="6" @bind="_document"
                      placeholder='{"mcpServers": { … }}'></textarea>

            <div class="toolbar" style="margin-top:.75rem">
                <button @onclick="AnalyseAsync" disabled="@_busy">Einlesen und ansehen</button>
                @if (_documentName is { Length: > 0 })
                {
                    <span class="muted">@_documentName</span>
                }
            </div>
        </div>

        <div class="card">
            <h3 style="margin-top:0">… oder von Hand</h3>
            <div class="row">
                <div>
                    <label for="wizard-kind">Transport</label>
                    <select id="wizard-kind" @bind="_manualKind">
                        <option value="@UpstreamTransportKind.StreamableHttp">Streamable HTTP</option>
                        <option value="@UpstreamTransportKind.Stdio">stdio (lokales Programm)</option>
                    </select>
                </div>
                <div>
                    <label for="wizard-slug">Slug (Namespace)</label>
                    <input id="wizard-slug" @bind="_manualSlug" placeholder="github" />
                </div>
            </div>
            @if (_manualKind is UpstreamTransportKind.StreamableHttp)
            {
                <label for="wizard-url">Endpoint-URL</label>
                <input id="wizard-url" @bind="_manualUrl" placeholder="https://host/mcp" />
                <label>
                    <input type="checkbox" @bind="_manualAllowPrivate" />
                    Ziele im internen Netz erlauben (Loopback, privates Netz, Link-Local)
                </label>
                <RiskHint Title="Was die Freigabe interner Ziele öffnet"
                          WhenOn="@("Das Gateway darf für diesen Upstream Adressen im eigenen Netz aufrufen. Damit wird es zum Sprungbrett: Wer die Zieladresse setzen darf, erreicht darüber Dienste, die von außen nicht erreichbar sind (SSRF). Auf einer Cloud-Instanz gehört der Metadaten-Endpunkt dazu, und der gibt Zugangsdaten heraus.")"
                          WhenOff="@("Ein Ziel im internen Netz wird abgewiesen, bevor eine Verbindung entsteht. Das ist die Vorgabe für Neuanlagen.")"
                          Noticed="@("Der Aufruf sieht im Audit-Log aus wie jeder andere Upstream-Aufruf — er trägt den Slug, nicht das Ziel.")" />
            }
            else
            {
                <div class="row">
                    <div style="flex:2"><label for="wizard-cmd">Kommando</label><input id="wizard-cmd" @bind="_manualCommand" placeholder="npx" /></div>
                    <div style="flex:3"><label for="wizard-cmdargs">Argumente (durch Leerzeichen)</label><input id="wizard-cmdargs" @bind="_manualArgs" /></div>
                </div>
                <p class="muted" style="margin:.3rem 0 0">
                    Ein lokales Programm bekommt die Isolationsangabe aus Schritt 1:
                    <span class="mono">@(_session?.Mode is SetupSecurityMode.Workbench ? "Host" : "Container")</span>@(_session?.Mode is SetupSecurityMode.Shielded && string.IsNullOrWhiteSpace(_image) ? " — ohne Image weist der Validator ihn ab." : ".")
                </p>
            }
            <div class="toolbar" style="margin-top:.75rem">
                <button @onclick="AddManualAsync" disabled="@_busy">Server anlegen</button>
            </div>
            @if (_session?.Source is SetupSourceKind.Manual && _session.Applied is { Created.Count: > 0 } done)
            {
                <p class="msg-ok" style="margin-bottom:0">
                    Angelegt: @string.Join(", ", done.Created.Select(c => c.Slug)).
                </p>
            }
        </div>
    </div>;

    private async Task ReadFileAsync(InputFileChangeEventArgs args)
    {
        _busy = true;
        _message = null;
        try
        {
            var file = args.File;
            await using var stream = file.OpenReadStream(Wizard.MaxDocumentBytes);
            using var reader = new StreamReader(stream);
            _document = await reader.ReadToEndAsync();
            _documentName = file.Name;
            _ok = true;
            _message = $"'{file.Name}' gelesen ({file.Size} Bytes). Jetzt „Einlesen und ansehen“.";
        }
        catch (IOException exception)
        {
            // Der haeufigste Fall: die Datei ist groesser als die Grenze. Die Meldung nennt sie,
            // statt von einem Lesefehler zu sprechen.
            _ok = false;
            _message = "Die Datei ließ sich nicht lesen — höchstens "
                + $"{Wizard.MaxDocumentBytes / 1024} KiB. ({exception.Message})";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AnalyseAsync()
    {
        if (_session is not { } session)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_document))
            {
                _ok = false;
                _message = "Es ist keine Konfiguration da — Datei wählen oder Inhalt einfügen.";
                return;
            }

            // Der Dateiname reist als BESCHRIFTUNG mit, damit ein Befund seine Fundstelle nennen
            // kann. Geoeffnet wird er nie — das ist die Stopp-Regel aus WP4.3.
            var outcome = Wizard.Analyse(
                session, _document, string.IsNullOrWhiteSpace(_documentName) ? null : _documentName);
            session.Source = SetupSourceKind.Import;
            Sessions.Touch(session);

            _ok = outcome.AnyApplicable;
            _message = outcome.Summary;
            if (outcome.AnyApplicable)
            {
                session.Step = SetupStep.ImportReview;
            }
        }
        finally
        {
            _busy = false;
        }

        await Task.CompletedTask;
    }

    private async Task AddManualAsync()
    {
        if (_session is not { } session)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var config = BuildManual(out var error);
            if (config is null)
            {
                _ok = false;
                _message = error;
                return;
            }

            session.ContainerImage = string.IsNullOrWhiteSpace(_image) ? null : _image.Trim();
            var report = await Wizard.ApplyManualAsync(
                session, config, session.Owner ?? "anonym", CancellationToken.None);

            if (report.Refusal is { } refusal)
            {
                _ok = false;
                _message = refusal;
                return;
            }

            session.Source = SetupSourceKind.Manual;
            Sessions.Touch(session);
            _facts = await Wizard.ReadFactsAsync(CancellationToken.None);
            _ok = true;
            _message = $"'{config.Slug}' angelegt.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Baut die Konfiguration aus dem Formular. Die Isolationsangabe kommt aus Schritt 1 — sie wird
    /// hier <b>gesetzt</b> und nicht offengelassen: Eine fehlende Angabe hiess frueher
    /// stillschweigend „kein Schutz", und genau das weist <c>SecureUpstreamDefaults</c> heute ab.
    /// </summary>
    private UpstreamServerConfig? BuildManual(out string? error)
    {
        error = null;
        var slug = _manualSlug.Trim();
        if (slug.Length == 0)
        {
            error = "Der Slug fehlt.";
            return null;
        }

        try
        {
            if (_manualKind is UpstreamTransportKind.StreamableHttp)
            {
                return new UpstreamServerConfig(
                    slug, slug, UpstreamTransportKind.StreamableHttp, true,
                    Http: new HttpTransportOptions(
                        new Uri(_manualUrl.Trim()),
                        AllowLegacySse: true,
                        AllowPrivateTargets: _manualAllowPrivate));
            }

            if (string.IsNullOrWhiteSpace(_manualCommand))
            {
                error = "Das Kommando fehlt.";
                return null;
            }

            var isolation = _session?.Mode is SetupSecurityMode.Workbench
                ? new IsolationOptions(IsolationMode.Host)
                : new IsolationOptions(
                    IsolationMode.Container,
                    Image: string.IsNullOrWhiteSpace(_image) ? null : _image.Trim());

            return new UpstreamServerConfig(
                slug, slug, UpstreamTransportKind.Stdio, true,
                Stdio: new StdioTransportOptions(
                    _manualCommand.Trim(),
                    _manualArgs.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
                    Isolation: isolation));
        }
        catch (UriFormatException exception)
        {
            error = $"Die Adresse ist keine gültige URL: {exception.Message}";
            return null;
        }
    }

    // ── Schritt 5: Befunde ──────────────────────────────────────────────────────────────────────

    private RenderFragment StepImportReview => @<div class="card">
        <h2 style="margin-top:0">5 · Was in dieser Datei steht</h2>
        @if (_session?.ImportSource is { } source)
