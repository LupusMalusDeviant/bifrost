        @if (confirmations.Count > 0)
        {
            <div class="card card-accent" style="margin-top:1rem">
                <strong>Diese Auswahl verlangt eine ausdrückliche Bestätigung</strong>
                <p class="muted" style="margin:.3rem 0 0">
                    Bestätigt wird, was angelegt wird. Wer die Auswahl ändert, ändert diese Liste —
