    private async Task CreateAgentAsync()
    {
        if (_session is not { } session)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var name = _agentName.Trim();
            if (name.Length == 0)
            {
                _ok = false;
                _message = "Der Name fehlt.";
                return;
            }

            var ct = CancellationToken.None;
            var servers = _facts!.Upstreams;

            // Die Rolle. Ohne Global-Grant je Server eine Freigabe — 'server' ist die Ebene, die auf
            // alle Tools des Servers vererbt; eine Liste einzelner Tools waere beim naechsten
            // Discovery unvollstaendig.
            List<Grant> grants = _globalGrant || servers.Count == 0
                ? [new Grant(new PermissionScope(null, null),
                    [ToolAction.UseTool, ToolAction.ReadResource, ToolAction.UsePrompt])]
                : [.. servers.Select(server => new Grant(
                    new PermissionScope(server.Id, null),
                    [ToolAction.UseTool, ToolAction.ReadResource, ToolAction.UsePrompt]))];

            if (!_globalGrant && servers.Count == 0)
            {
                _message = "Es ist kein Server angeschlossen — die Rolle bekommt deshalb einen "
                    + "Global-Grant. Er greift auf das, was später dazukommt.";
            }

            var role = new Role(RoleId.New(), $"{name}-rolle", grants);
            await Rbac.UpsertRoleAsync(role, ct);

            // Das Profil. Gepinnt werden die Tools der angeschlossenen Server; alles Weitere bleibt
            // ueber die Meta-Tools erreichbar (ADR-0003) — deshalb bleibt Lazy an.
            var serverIds = servers.Select(server => server.Id).ToHashSet();
            var pinned = Catalog.Snapshot
                .Where(entry => entry.Kind is CatalogEntryKind.Tool && serverIds.Contains(entry.Server))
                .Select(entry => entry.Name)
                .ToList();
            var profile = new ToolProfile(ProfileId.New(), $"{name}-profil", pinned, LazyToolsEnabled: true);
            await Rbac.UpsertProfileAsync(profile, ct);

            var identity = new Identity(
                IdentityId.New(), name, IdentityKind.Agent, [role.Id], profile.Id);
            await Rbac.UpsertIdentityAsync(identity, ct);

            var issued = await ApiKeys.IssueAsync(identity.Id, $"{name}-key", null, ct);

            session.AgentName = name;
            session.Identity = identity.Id;
            session.RoleName = role.Name;
            session.ProfileName = profile.Name;
            session.KeyLabel = $"{name}-key";
            Sessions.Touch(session);

            // Der Klartext bleibt im Circuit. Er geht NICHT in den Sitzungszustand — ein Geheimnis,
            // das laenger lebt als der Blick darauf, ist eines zu viel.
            _key = issued.PlaintextKey;
            BuildSnippets(name);

            Wizard.Record(
                session.Owner ?? "anonym",
                $"Setup-Wizard: Agent '{name}' mit Rolle '{role.Name}', Profil '{profile.Name}' "
                + $"({pinned.Count} gepinnte Tools) und einem Schluessel angelegt.");

            _ok = true;
            _message = $"'{name}' angelegt — {pinned.Count} Tool(s) gepinnt.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void BuildSnippets(string agentName)
    {
        if (_key is not { } key)
        {
            _snippets = [];
            return;
        }

        var baseAddress = new Uri(Nav.BaseUri);
        _snippetHint = baseAddress.IsLoopback
            ? "Hinweis: Die Adresse stammt aus dem Browser-Aufruf und zeigt auf localhost — für "
                + "Agenten auf anderen Rechnern die extern erreichbare Adresse eintragen."
            : null;
        _snippets = ClientConfigSnippets.Build(baseAddress, agentName, key);
    }

    // ── Schritt 8: Client-Snippet ───────────────────────────────────────────────────────────────

    private RenderFragment StepSnippet => @<div class="card">
        <h2 style="margin-top:0">8 · Den Agenten anbinden</h2>
        @if (_key is null)
        {
            <p class="muted" style="margin-top:0">
                Der Schlüssel wird <strong>genau einmal</strong> angezeigt und liegt in keiner
                Ablage — auch nicht in der dieses Vorgangs. Nach einem Neuladen der Seite ist er
                deshalb weg. Das ist kein Verlust: Ein neuer Schlüssel kostet einen Klick, der alte
                bleibt bis zum Widerruf gültig und steht unter
                <a href="/rbac">Agenten &amp; Keys</a>.
            </p>
            <div class="toolbar">
                <button @onclick="IssueAnotherKeyAsync" disabled="@_busy">Neuen Schlüssel ausstellen</button>
            </div>
        }
        else
        {
            <div class="card card-accent">
                <strong class="msg-ok">Neuer Schlüssel (wird nie wieder angezeigt):</strong>
                <pre>@_key</pre>
                <p class="muted" style="margin:.3rem 0">
                    Enthält den Schlüssel im Klartext. Sinnvollerweise direkt übernehmen, nicht in
                    einen Chat oder ein Ticket kopieren.
                </p>
                @foreach (var snippet in _snippets)
                {
                    <label>@snippet.Client</label>
                    <pre class="mono">@snippet.Content</pre>
                }
                @if (_snippetHint is { } hint)
                {
                    <p class="muted" style="margin-bottom:0">@hint</p>
                }
            </div>
        }
    </div>;

    private async Task IssueAnotherKeyAsync()
    {
        if (_session is not { Identity: { } identity, AgentName: { } name })
        {
            return;
        }

        _busy = true;
        try
        {
            var label = $"{name}-key-{DateTime.UtcNow:yyyyMMddHHmm}";
            var issued = await ApiKeys.IssueAsync(identity, label, null, CancellationToken.None);
            _key = issued.PlaintextKey;
            _session.KeyLabel = label;
            Sessions.Touch(_session);
            BuildSnippets(name);
            Wizard.Record(
                _session.Owner ?? "anonym",
                $"Setup-Wizard: zweiter Schluessel '{label}' fuer Agent '{name}' ausgestellt.");
            _ok = true;
            _message = "Ein neuer Schlüssel ist ausgestellt.";
        }
        finally
        {
            _busy = false;
        }
    }

    // ── Schritt 9: Testaufruf ───────────────────────────────────────────────────────────────────

    private RenderFragment StepTestCall => @<div class="card">
        <h2 style="margin-top:0">9 · Der erste echte Aufruf</h2>
        <p class="muted" style="margin-top:0">
            Der Aufruf läuft über denselben Weg wie ein Aufruf des Agenten selbst: RBAC-Prüfung,
            Argument-Validierung, Routing, Timeout, Upstream, Audit. Als Aufrufer steht die eben
            angelegte Identität — nicht ein Administrator. Damit prüft dieser Schritt genau das,
            was danach im Betrieb passiert.
        </p>

        @{
            var callable = CallableTools();
        }
        @if (callable.Count == 0)
        {
            <div class="empty">
                <strong>Diese Instanz hat kein aufrufbares Tool.</strong>
                <p class="muted" style="margin:.35rem 0 0">
                    Entweder ist kein Server im Zustand <span class="mono">Healthy</span>, oder er
                    liefert keine Tools. Der Wizard stellt hier <em>keinen</em> Erfolg dar, den es
                    nicht gibt — zurück zu Schritt 6 und die Zeitlinie ansehen.
                </p>
            </div>
        }
        else
        {
            <div class="row">
                <div>
                    <label for="wizard-tool">Tool</label>
                    <select id="wizard-tool" @bind="_testTool">
                        <option value="">(wählen)</option>
                        @foreach (var tool in callable)
                        {
                            <option value="@tool.Name.Value">@tool.Name.Value</option>
                        }
                    </select>
                </div>
            </div>
            @if (callable.FirstOrDefault(t => t.Name.Value == _testTool) is { } selected)
            {
                <p class="muted" style="margin:.4rem 0 0">@selected.Description</p>
                <label for="wizard-schema">Erwartete Argumente</label>
                <pre id="wizard-schema">@FormatJson(selected.InputSchema.GetRawText())</pre>
            }
            <label for="wizard-args">Argumente (JSON)</label>
            <textarea id="wizard-args" class="mono" rows="3" @bind="_testArgs"></textarea>
            <div class="toolbar" style="margin-top:.75rem">
                <button @onclick="TestCallAsync" disabled="@_busy">Aufrufen</button>
            </div>
        }

        @if (_session?.TestResult is { } result)
        {
            <div class="card @(result.Succeeded ? "card-accent" : null)" style="margin-top:.75rem">
                <div class="toolbar" style="margin-top:0">
                    <strong class="mono">@result.Tool</strong>
                    <span class="badge @(result.Succeeded ? "badge-ok" : "badge-err")">@result.Status</span>
                </div>
                <p style="margin:.4rem 0 0">@result.Explanation</p>
                @if (result.Detail is { } detail)
                {
                    <pre style="margin-top:.5rem">@detail</pre>
                }
                @if (result.Succeeded)
                {
                    <p style="margin:.6rem 0 0">
                        Damit ist die Einrichtung durch: Ein Agent mit eigenem Schlüssel hat über
                        dieses Gateway ein Werkzeug eines fremden Servers aufgerufen, und der Aufruf
                        steht im <a href="/logs">Audit-Log</a>. Weiter geht es auf der
                        <a href="/">Oberfläche</a>.
                    </p>
                }
            </div>
        }
    </div>;

    private IReadOnlyList<CatalogEntry> CallableTools()
        => _session?.Identity is not { } identity
            ? []
            : [.. Catalog.GetViewFor(identity).PinnedTools
                .Concat(Catalog.Snapshot.Where(entry => entry.Kind is CatalogEntryKind.Tool))
                .DistinctBy(entry => entry.Name.Value)
                .OrderBy(entry => entry.Name.Value, StringComparer.Ordinal)];

    private async Task TestCallAsync()
    {
        if (_session is not { Identity: { } identity } session || string.IsNullOrWhiteSpace(_testTool))
        {
            _ok = false;
            _message = "Erst ein Tool wählen.";
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            JsonElement arguments;
            try
            {
                arguments = JsonSerializer.Deserialize<JsonElement>(_testArgs);
            }
            catch (JsonException exception)
            {
                _ok = false;
                _message = $"Die Argumente sind kein gültiges JSON: {exception.Message}";
                return;
            }

            var name = new NamespacedToolName(_testTool);
            var result = await Invoker.InvokeAsync(
                new ToolInvocationRequest(identity, CallOrigin.Ui, name, arguments, null),
                CancellationToken.None);

            session.TestTool = _testTool;
            session.TestResult = new SetupTestCall(
                _testTool,
                result.Status,
                result.Status is InvocationStatus.Success
                    ? FormatJson(result.Content?.GetRawText() ?? "")
                    : result.ErrorMessage,
                Explain(result.Status));
            Sessions.Touch(session);

            _ok = result.Status is InvocationStatus.Success;
            _message = _ok ? "Der Aufruf ist durchgelaufen." : "Der Aufruf ist nicht durchgelaufen.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Was dieses Ergebnis bedeutet — und was als Nächstes zu tun ist.
    /// <para>
    /// Der Unterschied, auf den es hier ankommt: <c>Denied</c> heisst „darf nie", und die Ursache
    /// liegt in Schritt 7. <c>ApprovalRequired</c> heisst „darf nach Freigabe" — der Aufruf ist
    /// nicht gescheitert, er wartet. Beide als „Fehler" darzustellen wuerde den zweiten Fall zu
    /// einer Fehlersuche machen, die es nicht gibt.
    /// </para>
    /// </summary>
    private static string Explain(InvocationStatus status) => status switch
    {
        InvocationStatus.Success =>
            "Durchgelaufen. Der Aufruf ist durch RBAC, Validierung, Routing und den Upstream "
            + "gegangen und steht im Audit-Log mit Origin=Ui und dieser Identität.",
        InvocationStatus.Denied =>
            "Abgelehnt: Die Rolle dieser Identität deckt dieses Tool nicht ab. Das ist kein Defekt, "
            + "sondern die Rechteprüfung — zurück zu Schritt 7 und die Freigabe erweitern.",
        InvocationStatus.ValidationFailed =>
            "Die Argumente passen nicht zum Schema des Tools. Das Schema steht oben; der Aufruf hat "
            + "den Upstream nicht erreicht.",
        InvocationStatus.ToolNotFound =>
            "Dieses Tool gibt es im Katalog nicht (mehr). Häufigste Ursache: Der Server ist nicht "
            + "mehr Healthy — Schritt 6 zeigt, woran es liegt.",
        InvocationStatus.ApprovalRequired =>
            "Der Aufruf braucht eine menschliche Freigabe und wartet als Vorgang. Er ist NICHT "
            + "gescheitert: Unter „Freigaben“ lässt er sich erteilen oder ablehnen.",
        InvocationStatus.GuardBlocked =>
            "Die Inhaltsprüfung hat das Ergebnis zurückgehalten. Achtung: Der Upstream-Aufruf ist zu "
            + "diesem Zeitpunkt bereits gelaufen, ein Seiteneffekt also eingetreten.",
        InvocationStatus.Timeout =>
            "Der Upstream hat nicht rechtzeitig geantwortet. Ob er überhaupt erreichbar ist, sagt "
            + "die Zeitlinie in Schritt 6.",
        _ => "Der Upstream hat einen Fehler gemeldet. Der Text darunter stammt von ihm; die "
            + "Zeitlinie in Schritt 6 sagt, ob die Verbindung selbst steht.",
    };

    private static string FormatJson(string raw)
    {
        try
        {
            using var document = JsonDocument.Parse(raw);
            return JsonSerializer.Serialize(document, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return raw;
        }
    }
}
