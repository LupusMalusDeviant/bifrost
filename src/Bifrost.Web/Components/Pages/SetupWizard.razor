    private static string StateCss(string state) => state switch
    {
        nameof(UpstreamState.Healthy) => "badge-ok",
        nameof(UpstreamState.Degraded) => "badge-warn",
        nameof(UpstreamState.Failed) => "badge-err",
        _ => "badge-muted",
    };

    private async Task RefreshFactsAsync()
    {
        _busy = true;
        try
        {
            _facts = await Wizard.ReadFactsAsync(CancellationToken.None);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Schaltet einen Server ein oder aus — über denselben Supervisor, den auch die Serverseite
    /// benutzt. Danach wird gewartet, bis der Zustand sich bewegt hat: Ein „Aktivieren", nach dem
    /// die Tabelle unverändert dasteht, sieht aus wie ein Knopf ohne Wirkung.
    /// </summary>
    private async Task SetEnabledAsync(SetupUpstreamFacts upstream, bool enabled)
    {
        _busy = true;
        _message = null;
        try
        {
            await Supervisor.SetEnabledAsync(upstream.Id, enabled, CancellationToken.None);

            var deadline = DateTime.UtcNow.AddSeconds(10);
            while (DateTime.UtcNow < deadline
                && Supervisor.GetStatus(upstream.Id)?.State is UpstreamState.Starting)
            {
                await Task.Delay(150);
            }

            _facts = await Wizard.ReadFactsAsync(CancellationToken.None);
            var state = Supervisor.GetStatus(upstream.Id)?.State;
            _ok = !enabled || state is UpstreamState.Healthy or UpstreamState.Degraded;
            _message = enabled
                ? _ok
                    ? $"'{upstream.Slug}' läuft."
                    : $"'{upstream.Slug}' ist eingeschaltet, aber im Zustand '{state}'. Die Zeitlinie sagt, woran es liegt."
                : $"'{upstream.Slug}' ist abgeschaltet.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DiagnoseAsync(SetupUpstreamFacts upstream)
    {
        _busy = true;
        _message = null;
        try
        {
            var latest = await ConfigStore.GetAllLatestAsync(CancellationToken.None);
            if (!latest.TryGetValue(upstream.Id, out var version))
            {
                _ok = false;
                _message = $"Zu '{upstream.Slug}' liegt keine gespeicherte Konfiguration vor.";
                return;
            }

            _shownReport = await ConnectionDiagnostics.DiagnoseAsync(
                version.Config, CancellationToken.None);
            _shownSlug = upstream.Slug;
            _ok = _shownReport.Succeeded;
            _message = _shownReport.Succeeded
                ? $"'{upstream.Slug}': Verbindung ok — {_shownReport.Negotiation?.ToolCount ?? 0} Werkzeug(e)."
                : $"'{upstream.Slug}': {_shownReport.FirstFailure!.Code} — {_shownReport.FirstFailure.Check.Summary}";
        }
        finally
        {
            _busy = false;
        }
    }

