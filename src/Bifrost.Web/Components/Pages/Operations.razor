@page "/operations"
@using Bifrost.Abstractions.Operations
@attribute [Authorize(Policy = UiPolicies.Admin)]
@inject IDiagnosticService Diagnostics
@inject IBackupService Backups
@inject Bifrost.Core.Operations.BackupLocation BackupLocation
@inject ISupportBundleService SupportBundles
@inject IAuditSink Audit
@inject TimeProvider Time
@inject AuthenticationStateProvider AuthState

<h1>Betrieb</h1>
<p class="muted">
    Diagnose und Sicherung dieser Instanz (ADR-0024). Nur für Admins — eine vollständige Sicherung
    enthält den DataProtection-Key-Ring und ist damit so schützenswert wie die Instanz selbst.
</p>

<div class="card">
    <h3 style="margin-top:0">Diagnosebericht</h3>
    <p class="muted" style="margin-top:0">
        Liest nur. Einzige Ausnahme ist die Schreibprobe im Datenverzeichnis — sie legt eine
        Testdatei an und löscht sie sofort wieder.
    </p>
    <div class="toolbar">
        <button @onclick="RunDoctor" disabled="@_running">
            @(_running ? "Läuft …" : "Bericht erstellen")
        </button>
        @if (_report is not null)
        {
            <span class="muted">
                @_report.Checks.Count Prüfungen · @_report.Duration.TotalMilliseconds.ToString("N0") ms
            </span>
        }
    </div>

    @if (_report is null)
    {
        <div class="empty" style="margin-top:.75rem">
            Noch kein Bericht. Der Lauf dauert wenige Sekunden und verändert nichts.
        </div>
    }
    else
    {
        <div class="table-wrap" style="margin-top:.75rem">
            <table>
                <thead><tr><th>Status</th><th>Code</th><th>Befund</th><th>Nächste Handlung</th></tr></thead>
                <tbody>
                    @foreach (var check in _report.Checks)
                    {
                        <tr>
                            <td><span class="badge @Css(check.Status)">@check.Status</span></td>
                            <td class="mono">@check.Code</td>
                            <td>@check.Summary</td>
                            <td class="muted">@check.Remediation</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <h3 style="margin-top:0">Sicherung anlegen</h3>
    <p class="muted" style="margin-top:0">
        Der Pfad gilt auf dem Rechner, auf dem der Gateway läuft. Ein vorhandenes Archiv wird nie
        überschrieben. Ohne Passphrase entsteht ein <strong>unverschlüsseltes</strong> Vollbackup:
        Es enthält den Key-Ring und damit den Schlüssel zu allen gespeicherten Zugangsdaten.
    </p>
    <div class="row">
        <div>
            <label>Dateiname</label>
            <input data-testid="backup-path" @bind="_target" @bind:event="oninput"
                   placeholder="bifrost-2026-07-31.zip" />
            <div class="muted">im Sicherungsverzeichnis <code>@BackupLocation.Directory</code></div>
        </div>
        <div>
            <label>Passphrase (leer = unverschlüsselt)</label>
            <input type="password" @bind="_passphrase" autocomplete="new-password" />
        </div>
    </div>
    <div class="pill-list" style="margin-top:.6rem">
        <label class="pill"><input data-testid="backup-database" type="checkbox" @bind="_database" /> Datenbank</label>
        <label class="pill"><input data-testid="backup-keyring" type="checkbox" @bind="_keyRing" /> Key-Ring</label>
        <label class="pill"><input type="checkbox" @bind="_packages" /> Connector-Pakete</label>
        <label class="pill"><input type="checkbox" @bind="_config" /> Instanzkonfiguration</label>
    </div>
    <div class="toolbar" style="margin-top:.75rem">
        @* Eine Sicherung zerstört nichts — sie legt aber ein Geheimnis auf die Platte. Deshalb die
           Rückfrage an derselben Stelle wie bei den zerstörenden Aktionen. *@
        <span data-testid="backup-confirm">
            <ConfirmButton Label="Sicherung anlegen" What="@_target" OnConfirmed="CreateBackup" />
        </span>
        @if (_message is not null)
        {
            <span data-testid="backup-message" class="@(_ok ? "msg-ok" : "msg-err")">@_message</span>
        }
    </div>
    @if (_lastArchive is not null)
    {
        <div class="card-accent" style="margin-top:.75rem;padding:.75rem 1rem">
            <div class="mono">@_lastArchive</div>
            <div class="muted" style="margin-top:.3rem">@_lastHint</div>
        </div>
    }
</div>

@* WP5.6: Der Weg, auf dem ein Pilot etwas zum Analysieren mitschicken kann, ohne Vollzugriff zu
   geben. Vorschau zuerst — ein Archiv, dessen Inhalt man erst nach dem Schreiben sieht, ist bereits
   geschrieben, und danach verlaesst es das Haus. *@
<div class="card">
    <h3 style="margin-top:0">Support-Bundle</h3>
    <p class="muted" style="margin-top:0">
        Versionen, Konfiguration ohne Secretwerte, Diagnose, Zustand, Migrationsstand und
        Laufzeitangaben — jedes Dokument geht durch einen zentralen Maskierungslauf.
        <strong>Keine Auditinhalte und kein Credentialmaterial</strong>, auch nicht auf Wunsch:
        Der vollständige Auditexport bleibt davon getrennt (FR-P075).
    </p>
    <div class="row">
        <div style="flex:3">
            <label>Zielpfad (auf dem Rechner des Gateways; leer = Datenverzeichnis)</label>
            <input data-testid="bundle-path" @bind="_bundlePath" placeholder="/data/support/bundle.zip" />
        </div>
        <div>
            <label>Logzeilen</label>
            <input type="number" min="1" max="10000" @bind="_bundleLogLines" />
        </div>
    </div>
    <div class="toolbar" style="margin-top:1rem">
        <button class="btn-ghost" data-testid="bundle-preview" @onclick="PreviewBundle" disabled="@_bundleBusy">
            Vorschau
        </button>
        <button data-testid="bundle-create" @onclick="CreateBundle" disabled="@(_bundleBusy || _bundlePreview is null)">
            Bundle erzeugen
        </button>
        @if (_bundleMessage is not null)
        {
            <span data-testid="bundle-message" class="@(_bundleOk ? "msg-ok" : "msg-err")">@_bundleMessage</span>
        }
    </div>

    @if (_bundlePreview is not null)
    {
        <div class="table-wrap" style="margin-top:.75rem">
            <table>
                <thead><tr><th>Datei</th><th>Kategorie</th><th>Bytes</th></tr></thead>
                <tbody>
                    @foreach (var entry in _bundlePreview.Entries)
                    {
                        <tr>
                            <td class="mono">@entry.Path</td>
                            <td>@entry.Category</td>
                            <td>@entry.Bytes.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Was fehlt, steht sichtbar da: Ein Bundle ohne Logs soll nicht aussehen wie eine
           Installation ohne Vorfaelle. *@
        @if (_bundlePreview.SkippedCategories.Count > 0)
        {
            <ul class="muted" style="margin-top:.5rem">
                @foreach (var skip in _bundlePreview.SkippedCategories)
                {
                    <li><strong>@skip.Category:</strong> @skip.Reason</li>
                }
            </ul>
        }
    }

    @if (_lastBundle is not null)
    {
        <div class="card-accent" style="margin-top:.75rem;padding:.75rem 1rem">
            <div class="mono">@_lastBundle</div>
            <div class="muted" style="margin-top:.3rem">@_lastBundleHint</div>
        </div>
    }
</div>

<div class="card">
    <h3 style="margin-top:0">Wiederherstellung</h3>
    <p class="muted" style="margin-top:0">
        Bewusst nicht hier. Ein Restore tauscht Datenbank und Key-Ring <em>unter</em> dem laufenden
        Gateway aus — er braucht einen Wartungsmoment (ADR-0024 E5) und läuft deshalb über
        <span class="mono">bifrost restore &lt;archiv&gt;</span>. Der Befehl zeigt zuerst den Plan
        und wendet erst danach an; ein Überschreiben verlangt zusätzlich
        <span class="mono">--replace</span> und eine Bestätigung.
    </p>
</div>

@code {
    private DiagnosticReport? _report;
    private bool _running;

    private string _target = "";
    private string _passphrase = "";
    private bool _database = true, _keyRing = true, _packages = true, _config = true;
    private string? _message, _lastArchive, _lastHint;
    private bool _ok;

    private static string Css(CheckStatus status) => status switch
    {
        CheckStatus.Pass => "badge-ok",
        CheckStatus.Warning => "badge-warn",
        CheckStatus.Fail => "badge-err",
        _ => "badge-muted",
    };

    private async Task RunDoctor()
    {
        _running = true;
        try
        {
            _report = await Diagnostics.RunAsync(DiagnosticScope.All, CancellationToken.None);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task<string> UserAsync()
        => (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "?";

    // ── Support-Bundle (WP5.6) ──────────────────────────────────────────────
    private string _bundlePath = "";
    private int _bundleLogLines = 200;
    private bool _bundleBusy, _bundleOk;
    private string? _bundleMessage, _lastBundle, _lastBundleHint;
    private SupportBundlePreview? _bundlePreview;

    private SupportBundleRequest BundleRequest() => new(
        Categories: null,
        LogTailLines: Math.Clamp(_bundleLogLines, 1, 10000),
        OutputPath: string.IsNullOrWhiteSpace(_bundlePath) ? null : _bundlePath.Trim());

    private async Task PreviewBundle()
    {
        _bundleBusy = true;
        _bundleMessage = null;
        try
        {
            _bundlePreview = await SupportBundles.PreviewAsync(BundleRequest(), CancellationToken.None);
            _bundleOk = true;
            _bundleMessage = $"{_bundlePreview.Entries.Count} Dokument(e), "
                + $"{_bundlePreview.EstimatedBytes.ToString("N0")} Bytes roh.";
        }
        catch (Exception exception)
        {
            _bundleOk = false;
            _bundleMessage = exception.Message;
        }
        finally
        {
            _bundleBusy = false;
        }
    }

    private async Task CreateBundle()
    {
        _bundleBusy = true;
        _bundleMessage = null;
        try
        {
            var result = await SupportBundles.CreateAsync(BundleRequest(), CancellationToken.None);
            _lastBundle = result.ArchivePath;
            _lastBundleHint = $"{result.Bytes.ToString("N0")} Bytes · SHA-256 {result.Sha256[..12]}… · "
                + $"{result.Manifest.Redaction.RedactedFields} Feld(er) maskiert. "
                + "Vor dem Weitergeben trotzdem hineinsehen — das Archiv ist Text.";
            _bundleOk = true;
            _bundleMessage = "Bundle erzeugt.";

            // Derselbe Vorgang wie im REST-Weg: Wer ein Archiv erzeugt, das die Installation
            // verlaesst, steht danach im Audit.
            Audit.Record(new AuditEvent(
                Time.GetUtcNow(), null, CallOrigin.Ui, AuditEventKind.ConfigChanged, null,
                $"support-bundle-created:{result.Manifest.InstanceId}:{result.Sha256[..12]}",
                null, null, null, null, null, null, $"Support-Bundle durch {await UserAsync()}"));
        }
        catch (Exception exception)
        {
            _bundleOk = false;
            _bundleMessage = exception.Message;
        }
        finally
        {
            _bundleBusy = false;
        }
    }

    private BackupSections Sections()
    {
        var sections = BackupSections.None;
        if (_database) { sections |= BackupSections.Database; }
        if (_keyRing) { sections |= BackupSections.KeyRing; }
        if (_packages) { sections |= BackupSections.Packages; }
        if (_config) { sections |= BackupSections.Config; }
        return sections;
    }

    private async Task CreateBackup()
    {
        _message = null;
        _lastArchive = null;
        if (string.IsNullOrWhiteSpace(_target))
        {
            _ok = false;
            _message = "Zielpfad fehlt.";
            return;
        }

        var sections = Sections();
        if (sections is BackupSections.None)
        {
            _ok = false;
            _message = "Mindestens ein Bereich muss ausgewählt sein.";
            return;
        }

        try
        {
            var result = await Backups.CreateAsync(
                new BackupRequest(
                    BackupLocation.ResolveTarget(_target.Trim()),
                    sections,
                    string.IsNullOrEmpty(_passphrase) ? null : _passphrase),
                CancellationToken.None);

            UiAudit.Record(Audit, Time, await UserAsync(), AuditEventKind.ConfigChanged,
                $"backup-created:{result.Manifest.Sections}");

            _ok = true;
            _message = "Sicherung angelegt.";
            _lastArchive = result.ArchivePath;
            _lastHint = result.Manifest.Encrypted
                ? $"{result.SizeBytes:N0} Bytes, verschlüsselt. Ohne die Passphrase ist das Archiv wertlos."
                : result.Manifest.Sections.HasFlag(BackupSections.KeyRing)
                    ? $"{result.SizeBytes:N0} Bytes, UNVERSCHLÜSSELT und mit Key-Ring — so schützenswert wie die Instanz selbst."
                    : $"{result.SizeBytes:N0} Bytes, unverschlüsselt.";
            _passphrase = "";
        }
        catch (NotSupportedException exception)
        {
            // PostgreSQL: Es gibt keine Sicherung über diesen Weg, und das wird gesagt statt
            // vorgetäuscht (ADR-0024 E2).
            _ok = false;
            _message = exception.Message;
        }
        catch (Exception exception) when (exception is IOException or ArgumentException)
        {
            _ok = false;
            _message = exception.Message;
        }
    }
}
