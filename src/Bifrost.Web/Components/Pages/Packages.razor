@page "/packages"
@attribute [Authorize(Policy = UiPolicies.Admin)]
@inject IConnectorPackageStore Store
@inject IPublisherTrustStore Trust
@inject ConnectorPackageInstaller Installer
@inject ConnectorPackageResolver Resolver
@using System.Globalization
@using Bifrost.Abstractions
@using Bifrost.Core.Packaging

<h1>Connector-Pakete</h1>
<p class="muted">
    Signierte Connector-Pakete
    (<a href="https://github.com/LupusMalusDeviant/bifrost/blob/main/docs/adr/0016-versionierter-connector-plugin-vertrag.md">ADR-0016</a>).
    Installiert wird nur, was von einem gepinnten Herausgeber signiert ist und die Probe in
    Quarantäne besteht. Die vorherige Version bleibt liegen — deshalb ist ein Rollback ein Schalter
    und kein neuer Download.
</p>

@if (_message is { Length: > 0 })
{
    <p class="@(_failed ? "error" : "muted")">@_message</p>
}

<div class="card">
    <h2>Paket installieren</h2>
    <p class="muted">
        Eine <span class="mono">.mcpkg</span>-Datei. Verlangt das Manifest Zugriffe nach außen, sind
        sie unten je Zeile zu bestätigen — bei einem nicht eingestuften Herausgeber zusätzlich das
        Paket selbst.
    </p>
    <InputFile OnChange="OnFileSelected" accept=".mcpkg,.zip" />
    @if (_pending is not null)
    {
        <p class="mono" style="margin-top:.5rem">@_pending.Name (@Kilobytes(_pending.Size) KB)</p>
    }

    @if (_preview is { Skills.Count: > 0 })
    {
        <div class="card" style="margin-top:.75rem">
            <h3>Dieses Paket bringt @_preview.Skills.Count Skill(s) mit</h3>
            <p class="muted">
                Ein Skill ist eine <b>Anweisung an deinen Agenten</b>. Anders als ein Zugriff nach außen
                lässt er sich nicht einsperren — es gibt keine Sandbox für einen Satz. Deshalb sind
                Skills unabhängig von der Vertrauensstufe einzeln zu bestätigen, und die Zustimmung
                gilt <b>diesem Text</b>: Ändert er sich, verfällt sie.
            </p>
            @foreach (var skill in _preview.Skills)
            {
                <details style="margin-bottom:.5rem">
                    <summary>
                        <span class="mono">@_preview.Manifest.Id/@skill.Name</span>
                        @if (skill.Description is { Length: > 0 } description)
                        {
                            <span class="muted"> — @description</span>
                        }
                    </summary>
                    <p class="mono muted" style="margin:.25rem 0">
                        @_preview.Manifest.SkillConsentToken(skill)
                    </p>
                    <pre class="mono" style="white-space:pre-wrap;max-height:20rem;overflow:auto">@_preview.Texts[skill.Name]</pre>
                </details>
            }
            <label>
                <input type="checkbox" @bind="_acceptSkills" />
                Ich habe die Texte gelesen und stimme ihnen zu
            </label>
        </div>
    }

    <div class="row" style="margin-top:.5rem">
        <div style="flex:2">
            <label>Zugestimmte Zugriffe (eine je Zeile, z.&nbsp;B. <span class="mono">env:TOKEN</span>)</label>
            <textarea class="mono" rows="3" @bind="_grants"></textarea>
        </div>
    </div>
    <label>
        <input type="checkbox" @bind="_allowUntrusted" />
        Nicht eingestuften Herausgeber (Community) ausdrücklich freigeben
    </label>
    <div class="toolbar" style="margin-top:.5rem">
        <button @onclick="Install" disabled="@(_busy || _pending is null)">Installieren</button>
    </div>
</div>

@if (_removal is not null)
{
    <div class="card">
        <h2 style="margin-top:0">
            <span class="mono">@_removal.PackageId</span> entfernen
        </h2>
        @if (_removal.Skills.Count == 0)
        {
            <p class="muted">Dieses Paket hat keine Skills mitgebracht. Es geht nichts weiter verloren.</p>
        }
        else
        {
            <p>
                Mit dem Paket werden <strong>@_removal.Skills.Count Skill(s) gelöscht</strong> — samt
                ihrer Versionshistorie. Das lässt sich nicht rückgängig machen.
            </p>
            <ul>
                @foreach (var skill in _removal.Skills)
                {
                    <li>
                        <span class="mono">@skill.Name</span>
                        @if (skill.Source is null)
                        {
                            <strong> — von dir angepasst.</strong>
                            <span class="muted">
                                Die neueste Fassung stammt nicht mehr aus dem Paket. Diese Arbeit geht
                                mit verloren.
                            </span>
                        }
                    </li>
                }
            </ul>
        }
        <div class="toolbar" style="margin-top:.5rem">
            <button @onclick="ConfirmRemovePackage" disabled="@_busy">Endgültig entfernen</button>
            <button class="btn-ghost" @onclick="() => _removal = null" disabled="@_busy">Abbrechen</button>
        </div>
    </div>
}

<div class="card">
    @if (_packages.Count == 0)
    {
        <p class="muted">Kein Paket installiert.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Paket</th><th>Version</th><th>Zustand</th><th>Herausgeber</th>
                    <th>Stufe</th><th>Zugriffe</th><th>Installiert</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var package in _packages)
                {
                    <tr>
                        <td>
                            <div>@package.DisplayName</div>
                            <div class="mono muted">@package.PackageId</div>
                        </td>
                        <td class="mono">@package.Version</td>
                        <td><span class="badge @StateClass(package.State)">@package.State</span></td>
                        <td class="mono" title="@package.PublisherKeyId">
                            @Label(package.PublisherKeyId)
                        </td>
                        <td>@package.TrustLevel</td>
                        <td class="mono">
                            @(package.GrantedCapabilities.Count == 0
                                ? "—"
                                : string.Join(", ", package.GrantedCapabilities))
                        </td>
                        <td>@package.InstalledAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                        <td>
                            @if (package.State is PackageState.Superseded)
                            {
                                <button class="btn-sm" @onclick="() => Rollback(package.PackageId)"
                                        disabled="@_busy">Aktivieren</button>
                            }
                            @if (package.State is not PackageState.Active)
                            {
                                <button class="btn-sm btn-ghost"
                                        @onclick="() => RemoveVersion(package)"
                                        disabled="@_busy">Entfernen</button>
                            }
                            else
                            {
                                <button class="btn-sm btn-ghost"
                                        @onclick="() => RemovePackage(package.PackageId)"
                                        disabled="@_busy">Paket entfernen</button>
                            }
                        </td>
                    </tr>
                    @if (package.FailureReason is { Length: > 0 } reason)
                    {
                        <tr>
                            <td colspan="8" class="muted">Probe gescheitert: @reason</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    /// <summary>Obergrenze beim Hochladen — dieselbe wie im Reader, nur früher wirksam.</summary>
    private const long MaxUploadBytes = ConnectorPackageReader.MaxArchiveBytes;

    /// <summary>Was ein Paket mitbringt, bevor irgendetwas davon installiert ist.</summary>
    private sealed record SkillPreview(
        ConnectorManifest Manifest,
        IReadOnlyList<ConnectorSkill> Skills,
        IReadOnlyDictionary<string, string> Texts);

    /// <summary>Was ein Entfernen mitnehmen wuerde — angekuendigt, bevor es passiert.</summary>
    private sealed record RemovalPreview(string PackageId, IReadOnlyList<AssetInfo> Skills);

    private RemovalPreview? _removal;
    private List<InstalledConnectorPackage> _packages = [];
    private IBrowserFile? _pending;
    private byte[]? _bytes;
    private SkillPreview? _preview;
    private string _grants = "";
    private bool _allowUntrusted, _acceptSkills, _busy, _failed;
    private string? _message;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
        => _packages = [.. (await Store.ListAsync(CancellationToken.None))
            .OrderBy(p => p.PackageId, StringComparer.Ordinal)
            .ThenByDescending(p => p.InstalledAt)];

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        _pending = args.File;
        _message = null;
        _failed = false;
        _preview = null;
        _acceptSkills = false;
        _bytes = null;

        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = _pending.OpenReadStream(MaxUploadBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            _bytes = buffer.ToArray();

            // Erst prüfen, dann zeigen. Ein Text aus einem Paket, hinter dem niemand steht, sähe
            // auf dem Bildschirm genauso aus wie einer von einem gepinnten Herausgeber.
            using var forVerify = new MemoryStream(_bytes, writable: false);
            var verified = ConnectorPackageReader.Verify(forVerify, Trust.All);
            if (verified.Manifest.SkillsOrEmpty.Count > 0)
            {
                using var forTexts = new MemoryStream(_bytes, writable: false);
                _preview = new SkillPreview(
                    verified.Manifest,
                    verified.Manifest.SkillsOrEmpty,
                    ConnectorPackageReader.ReadSkillTexts(forTexts, verified.Manifest));
            }
        }
        catch (Exception exception) when (exception is ConnectorPackageException or IOException
            or InvalidOperationException)
        {
            Report(exception.Message, failed: true);
        }
    }

    private async Task Install()
    {
        if (_pending is null || _bytes is null)
        {
            return;
        }

        if (_preview is not null && !_acceptSkills)
        {
            Report("Die mitgelieferten Skills sind noch nicht bestätigt.", failed: true);
            return;
        }

        _busy = true;
        try
        {
            using var buffer = new MemoryStream(_bytes, writable: false);
            var accepted = new List<string>(ParseGrants(_grants));
            if (_preview is not null)
            {
                accepted.AddRange(_preview.Skills.Select(_preview.Manifest.SkillConsentToken));
            }

            var result = await Installer.InstallAsync(
                buffer,
                new ConnectorInstallOptions(accepted, _allowUntrusted),
                caller: null,
                CancellationToken.None);
            await Resolver.RefreshAsync(CancellationToken.None);
            Report(Summarize(result), failed: false);
            _pending = null;
            _bytes = null;
            _preview = null;
            _grants = "";
            _allowUntrusted = false;
            _acceptSkills = false;
        }
        catch (Exception exception) when (exception is ConnectorPackageException or IOException
            or InvalidOperationException)
        {
            // Der Grund gehört auf den Bildschirm: Ein abgewiesenes Paket ist fast immer eine
            // fehlende Zustimmung oder ein nicht gepinnter Herausgeber, und beides ist behebbar.
            Report(exception.Message, failed: true);
        }
        finally
        {
            _busy = false;
            await Reload();
        }
    }

    private async Task Rollback(string packageId) => await Guarded(async () =>
    {
        var active = await Installer.RollbackAsync(packageId, null, CancellationToken.None);
        await Resolver.RefreshAsync(CancellationToken.None);
        Report($"{packageId} läuft wieder auf {active.Version}.", failed: false);
    });

    private async Task RemoveVersion(InstalledConnectorPackage package) => await Guarded(async () =>
    {
        await Installer.RemoveVersionAsync(
            package.PackageId, package.Version, null, CancellationToken.None);
        await Resolver.RefreshAsync(CancellationToken.None);
        Report($"{package.PackageId} {package.Version} entfernt.", failed: false);
    });

    /// <summary>
    /// ADR-0021 F5: Erst ankuendigen, was mitgeht. Ein Loeschvorgang, der ungefragt fremde Arbeit
    /// mitnimmt, waere genau der Schritt, den man nicht rueckgaengig machen kann.
    /// </summary>
    private async Task RemovePackage(string packageId)
    {
        _message = null;
        _removal = new RemovalPreview(
            packageId, await Installer.PreviewRemovalAsync(packageId, CancellationToken.None));
    }

    private async Task ConfirmRemovePackage()
    {
        if (_removal is null)
        {
            return;
        }

        var packageId = _removal.PackageId;
        _removal = null;
        await Guarded(async () =>
        {
            var removedSkills = await Installer.RemovePackageAsync(
                packageId, null, CancellationToken.None);
            await Resolver.RefreshAsync(CancellationToken.None);
            Report(
                removedSkills.Count == 0
                    ? $"{packageId} vollständig entfernt."
                    : $"{packageId} vollständig entfernt, samt {string.Join(", ", removedSkills)}.",
                failed: false);
        });
    }

    private async Task Guarded(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (ConnectorPackageException exception)
        {
            Report(exception.Message, failed: true);
        }
        finally
        {
            _busy = false;
            await Reload();
        }
    }

    private void Report(string message, bool failed)
    {
        _message = message;
        _failed = failed;
    }

    /// <summary>
    /// Eine abgelöste lokale Fassung gehört auf den Bildschirm, nicht ins Log: Wer den Text
    /// angepasst hat, erfährt es sonst erst, wenn ein Agent sich anders verhält.
    /// </summary>
    private static string Summarize(ConnectorInstallResult result)
    {
        var text = $"{result.Package.PackageId} {result.Package.Version} ist aktiv.";
        if (result.Skills.Count > 0)
        {
            text += $" {result.Skills.Count} Skill(s) eingespielt.";
        }

        if (result.ReplacedLocalEdits.Count > 0)
        {
            text += " Achtung: Bei "
                + string.Join(", ", result.ReplacedLocalEdits.Select(s => s.Name))
                + " lag eine lokal angepasste Fassung vor. Sie bleibt in der Historie und lässt sich "
                + "unter Skills zurückschalten.";
        }

        return text;
    }

    private static IReadOnlyList<string> ParseGrants(string text)
        => [.. text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];

    private static string Kilobytes(long bytes)
        => (bytes / 1024).ToString(CultureInfo.InvariantCulture);

    private string Label(string keyId)
        => Trust.All.FirstOrDefault(k => k.KeyId == keyId)?.Label ?? keyId[..Math.Min(keyId.Length, 12)];

    private static string StateClass(PackageState state) => state switch
    {
        PackageState.Active => "badge-ok",
        PackageState.Failed => "badge-error",
        _ => "badge-muted",
    };
}
