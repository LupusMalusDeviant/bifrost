@page "/tasks"
@attribute [Authorize(Policy = UiPolicies.Operator)]
@inject ITaskStore TaskStore
@inject IAuditSink Audit
@inject TimeProvider Time
@inject AuthenticationStateProvider AuthState
@using System.Globalization
@using McpMcp.Abstractions

<h1>Vorgänge</h1>
<p class="muted">
    Langlaufende Vorgänge (<a href="https://github.com/LupusMalusDeviant/mcp-mcp/blob/main/docs/adr/0019-langlaufende-tasks-und-events.md">ADR-0019</a>).
    Der Zustand wird <em>geholt</em>, nicht zugestellt — diese Liste zeigt den Stand beim letzten
    Laden. Freigaben sind hier ebenfalls Vorgänge: eine wartende Anfrage steht auf
    <span class="mono">InputRequired</span>.
</p>

<div class="card">
    <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
        <label>Zustand
            <select @bind="_state" @bind:after="Reload">
                <option value="">alle</option>
                @foreach (var state in Enum.GetValues<TaskState>())
                {
                    <option value="@state">@state</option>
                }
            </select>
        </label>
        <button class="btn-sm" @onclick="Reload">Neu laden</button>
        <span class="muted">@_total Vorgänge</span>
    </div>
</div>

@if (_message is { Length: > 0 })
{
    <p class="muted">@_message</p>
}

<div class="card">
    @if (_tasks.Count == 0)
    {
        <p class="muted">Nichts vorhanden.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Angelegt (UTC)</th><th>Eigentümer</th><th>Tool</th><th>Zustand</th>
                        <th>Fortschritt</th><th>Abbruch</th><th>Ergebnis / Fehler</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in _tasks)
                    {
                        <tr>
                            <td class="mono">@task.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                            <td>@task.OwnerDescription</td>
                            <td class="mono">@task.Tool.Value</td>
                            <td class="mono">@task.State</td>
                            <td>@(task.Progress is { } p ? $"{p} %" : "—")</td>
                            <td class="mono">@(task.Cancellation is TaskCancellation.None ? "—" : task.Cancellation.ToString())</td>
                            <td>
                                <pre class="mono" style="max-width:320px;white-space:pre-wrap">@Outcome(task)</pre>
                            </td>
                            <td style="white-space:nowrap">
                                @if (!task.IsTerminal && task.Cancellation is TaskCancellation.None)
                                {
                                    <button class="btn-sm btn-danger" @onclick="() => RequestCancel(task)">Abbrechen</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<TaskRecord> _tasks = [];
    private long _total;
    private string _state = string.Empty;
    private string? _message;

    protected override Task OnInitializedAsync() => Reload();

    private async Task Reload()
    {
        var state = Enum.TryParse<TaskState>(_state, out var parsed) ? parsed : (TaskState?)null;
        var page = await TaskStore.ListAsync(new TaskFilter(State: state, PageSize: 200), CancellationToken.None);
        _tasks = page.Items;
        _total = page.TotalCount;
    }

    /// <summary>Zeigt, was der Vorgang hergibt: Ergebnis, Fehler oder erwartetes Folge-Input.</summary>
    private static string Outcome(TaskRecord task) => task switch
    {
        { Failure: { } failure } => $"{failure.Code}: {failure.Message}",
        { RedactedResult: { } result } => result.GetRawText(),
        { ExpectedInputSchema: { } schema } => $"erwartet: {schema.GetRawText()}",
        _ => "—",
    };

    private async Task<string> UserAsync()
        => (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "?";

    /// <summary>
    /// Bricht einen Vorgang ab. Läuft nichts, ist der Abbruch endgültig — und eine so beendete
    /// Freigabe ist nicht mehr einlösbar. Ist der Vorgang bereits eingelöst, sagt die Meldung das:
    /// Der Aufruf ist gelaufen, da ist nichts mehr zu stoppen.
    /// </summary>
    private async Task RequestCancel(TaskRecord task)
    {
        var outcome = await TaskStore.CancelAsync(task.Id, task.Revision, CancellationToken.None);
        _message = outcome switch
        {
            TaskUpdateOutcome.Applied =>
                "Abgebrochen. Eine Freigabe dazu ist nicht mehr einlösbar.",
            TaskUpdateOutcome.NotCancellable =>
                "Bereits eingelöst — der Aufruf ist gelaufen und lässt sich nicht mehr abbrechen.",
            TaskUpdateOutcome.RevisionMismatch =>
                "Der Vorgang hat sich zwischenzeitlich geändert — bitte neu laden.",
            TaskUpdateOutcome.Terminal => "Der Vorgang ist schon abgeschlossen.",
            _ => "Der Vorgang existiert nicht mehr.",
        };

        if (outcome is TaskUpdateOutcome.Applied)
        {
            UiAudit.Record(Audit, Time, await UserAsync(), AuditEventKind.ConfigChanged,
                $"task-cancel-requested:{task.Id}");
        }

        await Reload();
    }
}
